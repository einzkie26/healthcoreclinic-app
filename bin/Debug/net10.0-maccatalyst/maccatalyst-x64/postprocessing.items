<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <_PostProcessingItem Include="healthcoreclinic-app-demo.app/Contents\MacOS\">
      <IsAppExtension>false</IsAppExtension>
