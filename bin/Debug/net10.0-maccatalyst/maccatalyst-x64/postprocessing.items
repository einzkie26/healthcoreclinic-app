      <DSymName>healthcoreclinic-app-demo.app.dSYM</DSymName>
      <SourceProjectPath>E:\projects\sharp_MAUI_HEALTHCARE\healthcoreclinic-app-demo</SourceProjectPath>
      <IsXPCService></IsXPCService>
