@page "/receptionist/patients"
@layout ReceptionistLayout
@using healthcoreclinic_app_demo.Services
@using healthcoreclinic_app_demo.Models
@inject AuthService Auth
@inject NavigationManager Nav

<div class="patients-container">
    <div class="page-header">
        <div>
            <h1>Patient Records</h1>
            <p>View and register patients</p>
        </div>
        <button class="btn btn-primary" @onclick="OpenCreatePatientModal" disabled="@isLoading">
            <span class="icon ui-icon ui-icon-plus" aria-hidden="true"></span>
            <span>Register Patient</span>
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(messageText))
    {
        <div class="status-message @(isSuccess ? "success" : "error")">
            <span class="msg-icon">
                <span class="ui-icon @(isSuccess ? "ui-icon-check" : "ui-icon-alert")" aria-hidden="true"></span>
            </span>
            <span>@messageText</span>
            <button class="msg-close" @onclick="() => messageText = null" aria-label="Dismiss message">
                <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
            </button>
        </div>
    }

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading patient records...</p>
        </div>
    }
    else if (patients == null || patients.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><span class="ui-icon ui-icon-users" aria-hidden="true"></span></div>
            <h3>No Patients Registered</h3>
            <p>Register your first patient to get started</p>
            <button class="btn btn-primary" @onclick="OpenCreatePatientModal">
                Register First Patient
            </button>
        </div>
    }
    else
    {
        <div class="search-section">
            <input @bind="searchQuery" 
                   @bind:event="oninput"
                   type="text" 
                   class="search-input"
                   placeholder="Search by patient name..." />
        </div>

        <div class="patients-grid">
            <div class="table-responsive">
                <table class="patients-table">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Birth Date</th>
                            <th>Gender</th>
                            <th>Contact</th>
                            <th>Address</th>
                            <th>Registered</th>
                            <th class="actions-col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in FilteredPatients)
                        {
                            <tr class="patient-row" @onclick="() => SelectPatient(patient)" style="cursor: pointer;">
                                <td class="font-weight-bold">@patient.FullName</td>
                                <td>@(patient.BirthDate.HasValue ? patient.BirthDate?.ToString("MMM dd, yyyy") : "Not provided")</td>
                                <td>@(string.IsNullOrEmpty(patient.Gender) ? "-" : patient.Gender)</td>
                                <td>@(string.IsNullOrEmpty(patient.ContactNumber) ? "-" : patient.ContactNumber)</td>
                                <td>@(string.IsNullOrEmpty(patient.Address) ? "-" : patient.Address)</td>
                                <td>@patient.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="actions-col" @onclick:stopPropagation>
                                    <button class="action-btn edit" @onclick="() => OpenEditPatientModal(patient)" title="Edit">
                                        <span class="ui-icon ui-icon-edit" aria-hidden="true"></span>
                                    </button>
                                    <button class="action-btn archive" @onclick="() => ConfirmArchivePatient(patient)" title="Archive">
                                        <span class="ui-icon ui-icon-trash" aria-hidden="true"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (FilteredPatients.Count == 0 && !string.IsNullOrWhiteSpace(searchQuery))
        {
            <div class="no-results">
                <p>No patients found matching "<strong>@searchQuery</strong>"</p>
            </div>
        }
    }

    <!-- Create Patient Modal -->
    @if (showPatientModal)
    {
        <div class="modal-overlay" @onclick="ClosePatientModal">
            <div class="modal-content" @onclick:stopPropagation>
                <div class="modal-header">
                    <h2>Register New Patient</h2>
                    <button class="close-btn" @onclick="ClosePatientModal" aria-label="Close">
                        <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                    </button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(modalMessage))
                    {
                        <div class="status-message @(modalSuccess ? "success" : "error")">
                            <span class="msg-icon">
                                <span class="ui-icon @(modalSuccess ? "ui-icon-check" : "ui-icon-alert")" aria-hidden="true"></span>
                            </span>
                            <span>@modalMessage</span>
                        </div>
                    }

                    <div class="form-group">
                        <label>Full Name *</label>
                        <input @bind="formData.FullName" 
                               @bind:event="oninput"
                               placeholder="Enter patient full name" 
                               disabled="@isSubmitting" />
                        @if (errors.ContainsKey("name") && !string.IsNullOrEmpty(errors["name"]))
                        {
                            <span class="error-text">@errors["name"]</span>
                        }
                    </div>

                    <div class="form-row two-col">
                        <div class="form-group">
                            <label>Birth Date</label>
                            <input @bind="formData.BirthDate" 
                                   type="date" 
                                   disabled="@isSubmitting" />
                        </div>
                        <div class="form-group">
                            <label>Gender</label>
                            <select @bind="formData.Gender" disabled="@isSubmitting">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Contact Number</label>
                        <input @bind="formData.ContactNumber" 
                               placeholder="e.g., 09123456789" 
                               disabled="@isSubmitting" />
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        <textarea @bind="formData.Address" 
                                  placeholder="Enter patient address" 
                                  disabled="@isSubmitting"
                                  rows="3"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePatientModal" disabled="@isSubmitting">
                        Cancel
                    </button>
                    <button class="btn btn-primary" @onclick="CreatePatient" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="loader"></span>
                            <span>Registering...</span>
                        }
                        else
                        {
                            <span>Register Patient</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Patient Details Modal -->
    @if (showPatientDetails && selectedPatient != null)
    {
        <div class="modal-overlay" @onclick="() => showPatientDetails = false">
            <div class="modal-content details-modal" @onclick:stopPropagation>
                <div class="modal-header">
                    <h2>Patient Details</h2>
                    <button class="close-btn" @onclick="() => showPatientDetails = false" aria-label="Close">
                        <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="detail-grid">
                        <div class="detail-item">
                            <label>Full Name</label>
                            <p>@selectedPatient.FullName</p>
                        </div>

                        <div class="detail-item">
                            <label>Birth Date</label>
                            <p>@(selectedPatient.BirthDate.HasValue ? selectedPatient.BirthDate?.ToString("MMMM dd, yyyy") : "Not provided")</p>
                        </div>

                        <div class="detail-item">
                            <label>Gender</label>
                            <p>@selectedPatient.Gender</p>
                        </div>

                        <div class="detail-item">
                            <label>Contact Number</label>
                            <p>@selectedPatient.ContactNumber</p>
                        </div>

                        <div class="detail-item full-width">
                            <label>Address</label>
                            <p>@selectedPatient.Address</p>
                        </div>

                        <div class="detail-item">
                            <label>Patient ID</label>
                            <p class="text-muted">@selectedPatient.PatientID</p>
                        </div>

                        <div class="detail-item">
                            <label>Registered</label>
                            <p class="text-muted">@selectedPatient.CreatedAt.ToString("MMM dd, yyyy - HH:mm")</p>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showPatientDetails = false">
                        Close
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Edit Patient Modal -->
    @if (showEditModal && editingPatient != null)
    {
        <div class="modal-overlay" @onclick="CloseEditModal">
            <div class="modal-content" @onclick:stopPropagation>
                <div class="modal-header">
                    <h2>Edit Patient</h2>
                    <button class="close-btn" @onclick="CloseEditModal" aria-label="Close">
                        <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                    </button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(editModalMessage))
                    {
                        <div class="status-message @(editModalSuccess ? "success" : "error")">
                            <span class="msg-icon">
                                <span class="ui-icon @(editModalSuccess ? "ui-icon-check" : "ui-icon-alert")" aria-hidden="true"></span>
                            </span>
                            <span>@editModalMessage</span>
                        </div>
                    }

                    <div class="form-group">
                        <label>Full Name *</label>
                        <input @bind="editFormData.FullName" 
                               @bind:event="oninput"
                               placeholder="Enter patient full name" 
                               disabled="@isSubmitting" />
                        @if (errors.ContainsKey("name") && !string.IsNullOrEmpty(errors["name"]))
                        {
                            <span class="error-text">@errors["name"]</span>
                        }
                    </div>

                    <div class="form-row two-col">
                        <div class="form-group">
                            <label>Birth Date</label>
                            <input @bind="editFormData.BirthDate" 
                                   type="date" 
                                   disabled="@isSubmitting" />
                        </div>
                        <div class="form-group">
                            <label>Gender</label>
                            <select @bind="editFormData.Gender" disabled="@isSubmitting">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Contact Number</label>
                        <input @bind="editFormData.ContactNumber" 
                               placeholder="e.g., 09123456789" 
                               disabled="@isSubmitting" />
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        <textarea @bind="editFormData.Address" 
                                  placeholder="Enter patient address" 
                                  disabled="@isSubmitting"
                                  rows="3"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseEditModal" disabled="@isSubmitting">
                        Cancel
                    </button>
                    <button class="btn btn-primary" @onclick="SaveEditedPatient" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="loader"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Changes</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Archive Patient Confirmation Modal -->
    @if (showArchiveConfirm && patientToArchive != null)
    {
        <div class="modal-overlay" @onclick="() => showArchiveConfirm = false">
            <div class="modal-content confirm-modal" @onclick:stopPropagation>
                <div class="modal-header">
                    <h2>Archive Patient</h2>
                    <button class="close-btn" @onclick="() => showArchiveConfirm = false" aria-label="Close">
                        <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to archive <strong>@patientToArchive.FullName</strong>'s record?</p>
                    <p class="text-warning">The patient will no longer appear in active records.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showArchiveConfirm = false" disabled="@isSubmitting">
                        Cancel
                    </button>
                    <button class="btn btn-danger" @onclick="ArchivePatient" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="loader"></span>
                            <span>Archiving...</span>
                        }
                        else
                        {
                            <span>Archive Patient</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Patient>? patients;
    private Patient? selectedPatient;
    private bool showPatientModal;
    private bool showPatientDetails;
    private bool isLoading = true;
    private bool isSubmitting;
    private string? messageText;
    private bool isSuccess;
    private string? modalMessage;
    private bool modalSuccess;
    private string searchQuery = string.Empty;
    private Dictionary<string, string> errors = new()
    {
        { "name", "" }
    };

    private class FormData
    {
        public string? FullName { get; set; }
        public DateTime? BirthDate { get; set; }
        public string? BirthDateStr { get; set; }
        public string? Gender { get; set; }
        public string? ContactNumber { get; set; }
        public string? Address { get; set; }

        public DateTime? GetBirthDate()
        {
            // First try to use the direct DateTime property
            if (BirthDate.HasValue)
            {
                System.Diagnostics.Debug.WriteLine($"OK Using direct BirthDate property: {BirthDate:yyyy-MM-dd}");
                return BirthDate;
            }

            // Fallback to string parsing
            if (string.IsNullOrEmpty(BirthDateStr))
            {
                System.Diagnostics.Debug.WriteLine($"BirthDateStr is empty or null");
                return null;
            }
            if (DateTime.TryParse(BirthDateStr, out var date))
            {
                System.Diagnostics.Debug.WriteLine($"OK BirthDateStr '{BirthDateStr}' parsed to {date:yyyy-MM-dd}");
                return date;
            }
            System.Diagnostics.Debug.WriteLine($"Failed to parse BirthDateStr: '{BirthDateStr}'");
            return null;
        }
    }

    private FormData formData = new();

    private List<Patient> FilteredPatients
    {
        get
        {
            if (patients == null)
                return new List<Patient>();

            if (string.IsNullOrWhiteSpace(searchQuery))
                return patients;

            var query = searchQuery.ToLower();
            return patients.Where(p => p.FullName.ToLower().Contains(query)).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        isLoading = true;
        patients = await Auth.GetAllPatientsAsync();
        isLoading = false;
    }

    private void OpenCreatePatientModal()
    {
        formData = new FormData();
        errors.Clear();
        modalMessage = null;
        showPatientModal = true;
    }

    private void ClosePatientModal()
    {
        showPatientModal = false;
        formData = new FormData();
        errors.Clear();
    }

    private void SelectPatient(Patient patient)
    {
        selectedPatient = patient;
        showPatientDetails = true;
    }

    private void ClearErrors()
    {
        errors = new Dictionary<string, string>
        {
            { "name", "" }
        };
    }

    private bool ValidateForm()
    {
        ClearErrors();

        if (string.IsNullOrWhiteSpace(formData.FullName))
            errors["name"] = "Patient name is required.";
        else if (formData.FullName.Length < 3)
            errors["name"] = "Patient name must be at least 3 characters.";

        var hasErrors = errors.Values.Any(e => !string.IsNullOrEmpty(e));
        System.Diagnostics.Debug.WriteLine($"ValidateForm result: {!hasErrors} | Errors: {string.Join(", ", errors.Where(e => !string.IsNullOrEmpty(e.Value)).Select(e => $"{e.Key}={e.Value}"))}");
        
        return !hasErrors;
    }

    private async Task CreatePatient()
    {
        if (!ValidateForm())
        {
            modalSuccess = false;
            modalMessage = "Please fix the errors above.";
            System.Diagnostics.Debug.WriteLine($"Validation failed");
            await InvokeAsync(StateHasChanged);
            return;
        }

        isSubmitting = true;
        modalMessage = null;

        try
        {
            System.Diagnostics.Debug.WriteLine($"CreatePatient called: Name='{formData.FullName}', BirthDate='{formData.BirthDateStr}', Gender='{formData.Gender}'");
            await Task.Delay(400);

            var result = await Auth.CreatePatientAsync(
                formData.FullName ?? string.Empty,
                formData.GetBirthDate(),
                formData.Gender,
                formData.ContactNumber,
                formData.Address);

            modalSuccess = result.Success;
            modalMessage = result.Message;
            System.Diagnostics.Debug.WriteLine($"CreatePatient result: Success={result.Success}, Message={result.Message}");

            if (result.Success)
            {
                await Task.Delay(800);
                ClosePatientModal();
                messageText = result.Message;
                isSuccess = true;
                await LoadPatients();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error creating patient: {ex.Message}");
            modalSuccess = false;
            modalMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Edit Patient Modal Variables
    private bool showEditModal = false;
    private Patient? editingPatient;
    private FormData editFormData = new();
    private string? editModalMessage;
    private bool editModalSuccess;

    private void OpenEditPatientModal(Patient patient)
    {
        editingPatient = patient;
        System.Diagnostics.Debug.WriteLine($"OpenEditPatientModal - Patient BirthDate from DB: {(patient.BirthDate.HasValue ? patient.BirthDate.Value.ToString("yyyy-MM-dd") : "NULL")}");
        
        editFormData = new FormData
        {
            FullName = patient.FullName,
            BirthDate = patient.BirthDate,
            Gender = patient.Gender,
            ContactNumber = patient.ContactNumber,
            Address = patient.Address
        };
        editModalMessage = null;
        showEditModal = true;
        System.Diagnostics.Debug.WriteLine($"OK Edit modal opened for patient: {patient.FullName}, BirthDate={editFormData.BirthDate}");
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingPatient = null;
        editFormData = new FormData();
        editModalMessage = null;
    }

    private async Task SaveEditedPatient()
    {
        if (editingPatient == null) return;

        if (string.IsNullOrWhiteSpace(editFormData.FullName))
        {
            editModalSuccess = false;
            editModalMessage = "Patient name is required.";
            return;
        }

        isSubmitting = true;
        editModalMessage = null;

        try
        {
            System.Diagnostics.Debug.WriteLine($"SaveEditedPatient - Before parsing:");
            System.Diagnostics.Debug.WriteLine($"  - BirthDateStr: '{editFormData.BirthDateStr}' (Type: {editFormData.BirthDateStr?.GetType().Name ?? "null"})");
            System.Diagnostics.Debug.WriteLine($"  - BirthDateStr.Length: {editFormData.BirthDateStr?.Length}");
            System.Diagnostics.Debug.WriteLine($"  - BirthDateStr empty?: {string.IsNullOrEmpty(editFormData.BirthDateStr)}");
            
            var birthDate = editFormData.GetBirthDate();
            
            System.Diagnostics.Debug.WriteLine($"SaveEditedPatient - After parsing:");
            System.Diagnostics.Debug.WriteLine($"  - Parsed BirthDate: {(birthDate.HasValue ? birthDate.Value.ToString("yyyy-MM-dd") : "NULL")}");
            System.Diagnostics.Debug.WriteLine($"  - PatientID={editingPatient.PatientID}, Name='{editFormData.FullName}'");
            
            await Task.Delay(400);

            var result = await Auth.UpdatePatientAsync(
                editingPatient.PatientID,
                editFormData.FullName ?? string.Empty,
                birthDate,
                editFormData.Gender,
                editFormData.ContactNumber,
                editFormData.Address);

            editModalSuccess = result.Success;
            editModalMessage = result.Message;
            System.Diagnostics.Debug.WriteLine($"SaveEditedPatient result: Success={result.Success}, Message={result.Message}");

            if (result.Success)
            {
                await Task.Delay(800);
                CloseEditModal();
                messageText = result.Message;
                isSuccess = true;
                await LoadPatients();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error saving patient: {ex.Message}");
            editModalSuccess = false;
            editModalMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Archive Patient Modal Variables
    private bool showArchiveConfirm = false;
    private Patient? patientToArchive;

    private void ConfirmArchivePatient(Patient patient)
    {
        patientToArchive = patient;
        showArchiveConfirm = true;
        System.Diagnostics.Debug.WriteLine($"OK Archive confirmation opened for patient: {patient.FullName}");
    }

    private async Task ArchivePatient()
    {
        if (patientToArchive == null) return;

        isSubmitting = true;

        try
        {
            System.Diagnostics.Debug.WriteLine($"ArchivePatient called: PatientID={patientToArchive.PatientID}");
            await Task.Delay(400);

            var result = await Auth.ArchivePatientAsync(patientToArchive.PatientID);

            System.Diagnostics.Debug.WriteLine($"ArchivePatient result: Success={result.Success}, Message={result.Message}");

            if (result.Success)
            {
                await Task.Delay(800);
                showArchiveConfirm = false;
                patientToArchive = null;
                messageText = result.Message;
                isSuccess = true;
                await LoadPatients();
            }
            else
            {
                messageText = result.Message;
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error archiving patient: {ex.Message}");
            messageText = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}

<style>
.patients-container {
    padding: 24px;
    max-width: 1400px;
    margin: 0 auto;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
    gap: 16px;
}

.page-header h1 {
    margin: 0;
    color: #1f2937;
    font-size: 28px;
    font-weight: 700;
}

.page-header p {
    margin: 4px 0 0 0;
    color: #6b7280;
    font-size: 14px;
}

.btn {
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
}

.btn-primary {
    background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
    color: #fff;
}

.btn-primary:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(79, 70, 229, 0.3);
}

.btn-secondary {
    background: #e5e7eb;
    color: #1f2937;
    border: 1px solid #d1d5db;
}

.btn-secondary:hover:not(:disabled) {
    background: #d1d5db;
}

.btn-danger {
    background: #dc2626;
    color: #fff;
}

.btn-danger:hover:not(:disabled) {
    background: #b91c1c;
}

.btn-success {
    background: #16a34a;
    color: #fff;
}

.btn-success:hover:not(:disabled) {
    background: #15803d;
}

.btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.icon {
    font-size: 16px;
}

.action-btn {
    background: none;
    border: none;
    font-size: 18px;
    cursor: pointer;
    padding: 4px 8px;
    transition: all 0.2s ease;
    border-radius: 4px;
}

.action-btn:hover {
    background: #e5e7eb;
}

.action-btn.view:hover {
    color: #4f46e5;
}

.action-btn.edit:hover {
    color: #4f46e5;
}

.action-btn.archive:hover {
    color: #dc2626;
}

.actions-col {
    text-align: center;
    width: 100px;
    white-space: nowrap;
}

.confirm-modal {
    max-width: 400px;
}

.text-warning {
    color: #d97706;
    font-size: 13px;
    margin-top: 8px;
}

.status-message {
    padding: 12px 14px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    margin-bottom: 16px;
    animation: slideIn 0.3s ease;
}

@@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-8px);
