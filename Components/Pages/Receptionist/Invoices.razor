@page "/receptionist/invoices"
@layout ReceptionistLayout
@using healthcoreclinic_app_demo.Services
@using healthcoreclinic_app_demo.Models
@using healthcoreclinic_app_demo.Data
@using Microsoft.EntityFrameworkCore
@inject AuthService Auth
@inject ClinicDbContext Db

@code {
    private bool ShowGenerateInvoiceModal;
    private List<Invoice> InvoiceItems = new();
    private List<Patient> Patients = new();
    private InvoiceFormModel NewInvoice = new();
    private string StatusFilter = "All";
    private DateTime? DateFilter;
    private string? FormError;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        Patients = await Db.Patients
            .AsNoTracking()
            .Where(p => !p.IsArchived)
            .OrderBy(p => p.FullName)
            .ToListAsync();

        InvoiceItems = await Db.Invoices
            .Include(i => i.Patient)
            .Include(i => i.Payments)
            .AsNoTracking()
            .OrderByDescending(i => i.InvoiceDate)
            .ToListAsync();
    }

    private IEnumerable<Invoice> FilteredInvoices => InvoiceItems
        .Where(i => StatusFilter == "All" || GetComputedStatus(i) == StatusFilter)
        .Where(i => !DateFilter.HasValue || i.InvoiceDate.Date == DateFilter.Value.Date);

    private void OpenGenerateInvoiceModal()
    {
        FormError = null;
        NewInvoice = new InvoiceFormModel
        {
            InvoiceDate = DateTime.Today,
            DueDate = DateTime.Today.AddDays(10)
        };
        ShowGenerateInvoiceModal = true;
    }

    private void CloseGenerateInvoiceModal() => ShowGenerateInvoiceModal = false;

    private async Task SaveInvoiceAsync()
    {
        if (NewInvoice.PatientID <= 0)
        {
            FormError = "Please select a patient.";
            return;
        }

        if (NewInvoice.TotalAmount <= 0)
        {
            FormError = "Amount must be greater than zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NewInvoice.ServiceDescription))
        {
            FormError = "Service description is required.";
            return;
        }

        var invoiceNumber = await GenerateInvoiceNumberAsync();
        var invoice = new Invoice
        {
            InvoiceNumber = invoiceNumber,
            PatientID = NewInvoice.PatientID,
            CreatedBy = Auth.CurrentUserID,
            ServiceDescription = NewInvoice.ServiceDescription.Trim(),
            TotalAmount = NewInvoice.TotalAmount,
            InvoiceDate = NewInvoice.InvoiceDate,
            DueDate = NewInvoice.DueDate,
            Status = "Pending"
        };

        Db.Invoices.Add(invoice);
        await Db.SaveChangesAsync();
        ShowGenerateInvoiceModal = false;
        await LoadDataAsync();
    }

    private async Task<string> GenerateInvoiceNumberAsync()
    {
        var prefix = $"INV-{DateTime.UtcNow:yyyyMMdd}";
        var countToday = await Db.Invoices.CountAsync(i => i.InvoiceNumber.StartsWith(prefix));
        return $"{prefix}-{countToday + 1:000}";
    }

    private decimal GetTotalPaid(Invoice invoice) => invoice.Payments?.Sum(p => p.AmountPaid) ?? 0m;

    private decimal GetBalance(Invoice invoice) => invoice.TotalAmount - GetTotalPaid(invoice);

    private string GetComputedStatus(Invoice invoice)
    {
        var balance = GetBalance(invoice);
        if (balance <= 0)
        {
            return "Paid";
        }

        if (invoice.DueDate.HasValue && invoice.DueDate.Value.Date < DateTime.Today)
        {
            return "Overdue";
        }

        return "Pending";
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Paid" => "badge-success",
        "Pending" => "badge-warning",
        "Overdue" => "badge-danger",
        _ => "badge-neutral"
    };

    private sealed class InvoiceFormModel
    {
        public int PatientID { get; set; }
        public string ServiceDescription { get; set; } = string.Empty;
        public decimal TotalAmount { get; set; }
        public DateTime InvoiceDate { get; set; } = DateTime.Today;
        public DateTime? DueDate { get; set; }
    }
}

<div class="page-header">
    <h1>Invoices</h1>
    <button class="btn btn-primary" @onclick="OpenGenerateInvoiceModal">+ Generate Invoice</button>
</div>

<div class="filters">
    <select class="filter-select" @bind="StatusFilter">
        <option value="All">All Status</option>
        <option value="Paid">Paid</option>
        <option value="Pending">Pending</option>
        <option value="Overdue">Overdue</option>
    </select>
    <input type="date" class="filter-input" @bind="DateFilter" />
    <button class="btn btn-secondary" @onclick="LoadDataAsync">Refresh</button>
</div>

<div class="card">
    <table class="invoices-table">
        <thead>
            <tr>
                <th>Invoice</th>
                <th>Patient</th>
                <th>Service</th>
                <th>Amount</th>
                <th>Balance</th>
                <th>Date</th>
                <th>Due Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (!FilteredInvoices.Any())
            {
                <tr>
                    <td colspan="8" class="empty-row">No invoices found.</td>
                </tr>
            }
            else
            {
                @foreach (var invoice in FilteredInvoices)
                {
                    var status = GetComputedStatus(invoice);
                    <tr>
                        <td>@invoice.InvoiceNumber</td>
                        <td>@invoice.Patient?.FullName</td>
                        <td>@invoice.ServiceDescription</td>
                        <td>₱@invoice.TotalAmount.ToString("N2")</td>
                        <td>₱@GetBalance(invoice).ToString("N2")</td>
                        <td>@invoice.InvoiceDate.ToString("yyyy-MM-dd")</td>
                        <td>@(invoice.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td><span class="badge @GetStatusBadge(status)">@status</span></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (ShowGenerateInvoiceModal)
{
    <div class="modal-overlay" @onclick="CloseGenerateInvoiceModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Generate Invoice</h2>
                <button class="modal-close" @onclick="CloseGenerateInvoiceModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Patient</label>
                    <select @bind="NewInvoice.PatientID">
                        <option value="0">Select patient</option>
                        @foreach (var patient in Patients)
                        {
                            <option value="@patient.PatientID">@patient.FullName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Service Description</label>
                    <input type="text" placeholder="Enter service details" @bind="NewInvoice.ServiceDescription" />
                </div>
                <div class="form-group">
                    <label>Invoice Date</label>
                    <input type="date" @bind-value="NewInvoice.InvoiceDate" @bind-value:format="yyyy-MM-dd" />
                </div>
                <div class="form-group">
                    <label>Due Date</label>
                    <input type="date" @bind-value="NewInvoice.DueDate" @bind-value:format="yyyy-MM-dd" />
                </div>
                <div class="form-group">
                    <label>Amount</label>
                    <input type="number" step="0.01" min="0" @bind="NewInvoice.TotalAmount" />
                </div>
                @if (!string.IsNullOrWhiteSpace(FormError))
                {
                    <p class="form-error">@FormError</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseGenerateInvoiceModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveInvoiceAsync">Create Invoice</button>
            </div>
        </div>
    </div>
}

<style>
