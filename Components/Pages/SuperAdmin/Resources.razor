@page "/superadmin/resources"
@layout SuperAdminLayout
@using healthcoreclinic_app_demo.Services
@using healthcoreclinic_app_demo.Models
@using healthcoreclinic_app_demo.Data
@using Microsoft.EntityFrameworkCore
@inject AuthService Auth
@inject ClinicDbContext Db

@code {
    private List<ClinicResource> ResourceItems = new();
    private string StatusFilter = "All";
    private string TypeFilter = "All";

    protected override async Task OnInitializedAsync()
    {
        await LoadResourcesAsync();
    }

    private async Task LoadResourcesAsync()
    {
        ResourceItems = await Db.Resources
            .AsNoTracking()
            .OrderBy(r => r.ResourceName)
            .ToListAsync();
    }

    private IEnumerable<ClinicResource> FilteredResources => ResourceItems
        .Where(r => StatusFilter == "All" || r.Status == StatusFilter)
        .Where(r => TypeFilter == "All" || r.ResourceType == TypeFilter);

    private IEnumerable<string> TypeOptions => ResourceItems
        .Select(r => r.ResourceType)
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .Distinct()
        .OrderBy(t => t);

    private string GetStatusBadge(string status) => status switch
    {
        "Available" => "badge-success",
        "Low Stock" => "badge-warning",
        "Out of Stock" => "badge-danger",
        "In Use" => "badge-info",
        _ => "badge-neutral"
    };

    private static string FormatResourceId(int id) => $"R{id:0000}";
}

<div class="page-header">
    <div>
        <h1>Resource Management</h1>
        <p class="subtitle">Oversight across all clinics</p>
    </div>
</div>

<div class="summary-cards">
    <div class="summary-card">
        <h4>Total Resources</h4>
        <p class="summary-value">@ResourceItems.Count</p>
    </div>
    <div class="summary-card">
        <h4>Available</h4>
        <p class="summary-value">@ResourceItems.Count(r => r.Status == "Available")</p>
    </div>
    <div class="summary-card">
        <h4>Low Stock</h4>
        <p class="summary-value">@ResourceItems.Count(r => r.Status == "Low Stock")</p>
    </div>
    <div class="summary-card">
        <h4>Out of Stock</h4>
        <p class="summary-value">@ResourceItems.Count(r => r.Status == "Out of Stock")</p>
    </div>
</div>

<div class="filters">
    <select class="filter-select" @bind="TypeFilter">
        <option value="All">All Categories</option>
        @foreach (var type in TypeOptions)
        {
            <option value="@type">@type</option>
        }
    </select>
    <select class="filter-select" @bind="StatusFilter">
        <option value="All">All Status</option>
        <option value="Available">Available</option>
        <option value="Low Stock">Low Stock</option>
        <option value="Out of Stock">Out of Stock</option>
        <option value="In Use">In Use</option>
    </select>
</div>

<div class="card">
    <table class="resources-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Resource Name</th>
                <th>Category</th>
                <th>Quantity</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (!FilteredResources.Any())
            {
                <tr>
                    <td colspan="5" class="empty-row">No resources match the selected filters.</td>
                </tr>
            }
            else
            {
                @foreach (var resource in FilteredResources)
                {
                    <tr>
                        <td>@FormatResourceId(resource.ResourceID)</td>
                        <td>@resource.ResourceName</td>
                        <td>@resource.ResourceType</td>
                        <td>@resource.Quantity</td>
                        <td><span class="badge @GetStatusBadge(resource.Status)">@resource.Status</span></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<style>
.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.page-header h1 {
    margin: 0;
    color: #4f46e5;
}

.subtitle {
    margin: 6px 0 0;
    color: #6b7280;
}

.summary-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 20px;
}

.summary-card {
    background: white;
    border-radius: 10px;
    padding: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.summary-card h4 {
    margin: 0 0 6px 0;
    color: #6b7280;
    font-size: 0.9em;
}

.summary-value {
    margin: 0;
    font-size: 1.4em;
    font-weight: 700;
    color: #111827;
}

.filters {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.filter-select {
    padding: 8px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.9em;
}

.card {
    background: white;
    border-radius: 8px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.resources-table {
    width: 100%;
    border-collapse: collapse;
}

.resources-table thead {
    background-color: #f5f5f5;
}

.resources-table th {
    padding: 14px;
    text-align: left;
    font-weight: 600;
    color: #333;
    border-bottom: 2px solid #ddd;
}

.resources-table td {
    padding: 14px;
    border-bottom: 1px solid #eee;
}

.resources-table tbody tr:hover {
    background-color: #f9f9f9;
}

.empty-row {
    text-align: center;
    color: #9ca3af;
    padding: 24px 0;
}

.badge {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.85em;
    font-weight: 600;
}

.badge-success {
    background-color: #e8f5e9;
    color: #388e3c;
}

.badge-warning {
    background-color: #fff3e0;
    color: #f57c00;
}

.badge-danger {
    background-color: #ffebee;
    color: #c62828;
}

.badge-info {
    background-color: #e0f2fe;
    color: #0284c7;
}

.badge-neutral {
    background-color: #f3f4f6;
    color: #4b5563;
}

[data-theme="dark"] .summary-card,
[data-theme="dark"] .card {
    background: #1f2937;
    color: #e5e7eb;
}

[data-theme="dark"] .resources-table thead,
[data-theme="dark"] .resources-table thead tr,
[data-theme="dark"] .resources-table thead th {
    background-color: #1f2937 !important;
}

[data-theme="dark"] .resources-table th {
    color: #cbd5e1 !important;
    border-bottom-color: #475569 !important;
}

[data-theme="dark"] .resources-table td {
    color: #e2e8f0 !important;
    border-bottom-color: #334155 !important;
}

[data-theme="dark"] .resources-table tbody tr:hover {
    background-color: #374151 !important;
}
</style>
