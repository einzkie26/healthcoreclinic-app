@page "/superadmin/plans"
@layout SuperAdminLayout
@using healthcoreclinic_app_demo.Data
@using healthcoreclinic_app_demo.Models
@using Microsoft.EntityFrameworkCore
@inject ClinicDbContext Db

@code {
    private List<SubscriptionPlan> PlanItems = new();
    private bool ShowCreatePlanModal;
    private bool IsEdit;
    private int EditingPlanId;
    private PlanForm Form = new();
    private string? StatusMessage;
    private bool IsSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync()
    {
        PlanItems = await Db.SubscriptionPlans.AsNoTracking().OrderBy(p => p.Price).ToListAsync();
    }

    private void OpenCreatePlanModal()
    {
        IsEdit = false;
        EditingPlanId = 0;
        Form = new PlanForm();
        ShowCreatePlanModal = true;
    }

    private void OpenEditPlan(SubscriptionPlan plan)
    {
        IsEdit = true;
        EditingPlanId = plan.PlanID;
        Form = new PlanForm
        {
            PlanName = plan.PlanName,
            Price = plan.Price,
            MaxDoctors = plan.MaxDoctors,
            MaxReceptionists = plan.MaxReceptionists,
            HasAnalytics = plan.HasAnalytics,
            HasResourceAccess = plan.HasResourceAccess
        };
        ShowCreatePlanModal = true;
    }

    private void CloseCreatePlanModal() => ShowCreatePlanModal = false;

    private async Task SavePlanAsync()
    {
        if (string.IsNullOrWhiteSpace(Form.PlanName))
        {
            StatusMessage = "Plan name is required.";
            IsSuccess = false;
            return;
        }

        if (IsEdit)
        {
            var plan = await Db.SubscriptionPlans.FirstOrDefaultAsync(p => p.PlanID == EditingPlanId);
            if (plan == null)
                return;

            plan.PlanName = Form.PlanName.Trim();
            plan.Price = Form.Price;
            plan.MaxDoctors = Form.MaxDoctors;
            plan.MaxReceptionists = Form.MaxReceptionists;
            plan.HasAnalytics = Form.HasAnalytics;
            plan.HasResourceAccess = Form.HasResourceAccess;
        }
        else
        {
            Db.SubscriptionPlans.Add(new SubscriptionPlan
            {
                PlanName = Form.PlanName.Trim(),
                Price = Form.Price,
                MaxDoctors = Form.MaxDoctors,
                MaxReceptionists = Form.MaxReceptionists,
                HasAnalytics = Form.HasAnalytics,
                HasResourceAccess = Form.HasResourceAccess
            });
        }

        await Db.SaveChangesAsync();
        StatusMessage = IsEdit ? "Plan updated." : "Plan created.";
        IsSuccess = true;
        ShowCreatePlanModal = false;
        await LoadPlansAsync();
    }

    private async Task DeletePlanAsync(SubscriptionPlan plan)
    {
        Db.SubscriptionPlans.Remove(plan);
        await Db.SaveChangesAsync();
        await LoadPlansAsync();
    }

    private sealed class PlanForm
    {
        public string PlanName { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int? MaxDoctors { get; set; }
        public int? MaxReceptionists { get; set; }
        public bool HasResourceAccess { get; set; }
        public bool HasAnalytics { get; set; }
    }
}

<div class="page-header">
    <h1>Plans</h1>
    <button class="btn btn-primary" @onclick="OpenCreatePlanModal">+ Create Plan</button>
</div>

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="status-message @(IsSuccess ? "success" : "error")">
        <span>@StatusMessage</span>
        <button class="msg-close" @onclick="() => StatusMessage = null">×</button>
    </div>
}

<div class="plans-grid">
    @foreach (var plan in PlanItems)
    {
        <div class="plan-card">
            <h3>@plan.PlanName</h3>
            <p class="price">₱@plan.Price<span>/month</span></p>
            <ul class="features">
                <li>Doctors: @(plan.MaxDoctors?.ToString() ?? "Unlimited")</li>
                <li>Receptionists: @(plan.MaxReceptionists?.ToString() ?? "Unlimited")</li>
                <li>@(plan.HasAnalytics ? "Analytics enabled" : "Analytics disabled")</li>
                <li>@(plan.HasResourceAccess ? "Resource management enabled" : "Resource management disabled")</li>
            </ul>
            <button class="btn-small btn-edit" @onclick="() => OpenEditPlan(plan)">Edit</button>
            <button class="btn-small btn-delete" @onclick="() => DeletePlanAsync(plan)">Delete</button>
        </div>
    }
</div>

@if (ShowCreatePlanModal)
{
    <div class="modal-overlay" @onclick="CloseCreatePlanModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(IsEdit ? "Update Plan" : "Create Subscription Plan")</h2>
                <button class="modal-close" @onclick="CloseCreatePlanModal">×</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Plan Name</label>
                    <input type="text" @bind="Form.PlanName" />
                </div>
                <div class="form-group">
                    <label>Monthly Price</label>
                    <input type="number" step="0.01" min="0" @bind="Form.Price" />
                </div>
                <div class="form-group">
                    <label>Max Doctors</label>
                    <input type="number" min="0" @bind="Form.MaxDoctors" />
                </div>
                <div class="form-group">
                    <label>Max Receptionists</label>
                    <input type="number" min="0" @bind="Form.MaxReceptionists" />
                </div>
                <div class="form-group inline">
                    <label>Analytics Enabled</label>
                    <input type="checkbox" @bind="Form.HasAnalytics" />
                </div>
                <div class="form-group inline">
                    <label>Resource Management</label>
                    <input type="checkbox" @bind="Form.HasResourceAccess" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-delete" @onclick="CloseCreatePlanModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SavePlanAsync">Save Plan</button>
            </div>
        </div>
    </div>
}

<style>
.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.page-header h1 {
    margin: 0;
    color: #1e3c72;
}

.btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.95em;
    transition: all 0.3s ease;
}

.btn-primary {
    background-color: #2a5298;
    color: white;
}

.btn-primary:hover {
    background-color: #1e3c72;
}

.plans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
}

.plan-card {
    background: white;
    border-radius: 8px;
    padding: 25px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
}

.plan-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
}

.plan-card.featured {
    border: 3px solid #2a5298;
    transform: scale(1.05);
}

.badge-featured {
    position: absolute;
    top: 15px;
    right: 15px;
    background-color: #2a5298;
    color: white;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 0.8em;
    font-weight: 600;
}

.plan-card h3 {
    margin: 0 0 15px 0;
    color: #1e3c72;
    font-size: 1.5em;
}

.price {
    font-size: 1.8em;
    color: #2a5298;
    font-weight: bold;
    margin: 10px 0;
}

.price span {
    font-size: 0.6em;
    color: #666;
}

.features {
    list-style: none;
    padding: 15px 0;
    margin: 15px 0;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
}

.features li {
    padding: 8px 0;
    color: #666;
}

.btn-small {
    padding: 8px 15px;
    margin-right: 10px;
    margin-top: 15px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85em;
}

.btn-edit {
    background-color: #4caf50;
    color: white;
}

.btn-edit:hover {
    background-color: #45a049;
}

.btn-delete {
    background-color: #f44336;
    color: white;
}

.btn-delete:hover {
    background-color: #da190b;
}

.status-message {
    padding: 12px 16px;
    border-radius: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.status-message.success {
    background: #ecfdf3;
    color: #166534;
}

.status-message.error {
    background: #fef2f2;
    color: #991b1b;
}

.msg-close {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1.1em;
}

.form-group.inline {
    display: flex;
    align-items: center;
    gap: 8px;
}

.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1100;
}

.modal-content {
    background: white;
    width: 92%;
    max-width: 560px;
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
}

.modal-header,
.modal-footer {
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.modal-header {
    border-bottom: 1px solid #eee;
}

.modal-body {
    padding: 18px 20px;
    display: grid;
    gap: 12px;
}

.modal-close {
    border: none;
    background: transparent;
    font-size: 22px;
    cursor: pointer;
}

.form-group {
    display: grid;
    gap: 6px;
}

.form-group input,
.form-group textarea {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 9px 11px;
}
</style>
