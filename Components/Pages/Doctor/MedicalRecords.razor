@page "/doctor/medical-records"
@layout DoctorLayout
@using healthcoreclinic_app_demo.Services
@using healthcoreclinic_app_demo.Data
@using healthcoreclinic_app_demo.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService Auth
@inject ClinicDbContext Db

@code {
    private bool ShowModalFlag;
    private bool ShowDetailsModal;
    private bool ShowDeleteConfirm;
    private List<MedicalRecord> Records = new();
    private List<Patient> Patients = new();
    private RecordFormModel FormData = new();
    private MedicalRecord? SelectedRecord;
    private MedicalRecord? RecordToDelete;
    private string SearchTerm = string.Empty;
    private string DateFilter = "All";
    private string? FormError;

    protected override async Task OnInitializedAsync()
    {
        await LoadRecordsAsync();
    }

    private async Task LoadRecordsAsync()
    {
        Patients = await Db.Patients
            .AsNoTracking()
            .Where(p => !p.IsArchived)
            .OrderBy(p => p.FullName)
            .ToListAsync();

        Records = await Db.MedicalRecords
            .AsNoTracking()
            .Include(r => r.Patient)
            .Where(r => r.DoctorID == Auth.CurrentUserID)
            .OrderByDescending(r => r.CreatedAt)
            .ToListAsync();
    }

    private IEnumerable<MedicalRecord> FilteredRecords
    {
        get
        {
            var query = Records.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                query = query.Where(r => (r.Patient?.FullName ?? string.Empty).Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
                    || r.Diagnosis.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
            }

            var today = DateTime.Today;
            query = DateFilter switch
            {
                "Today" => query.Where(r => r.CreatedAt.Date == today),
                "ThisWeek" => query.Where(r => r.CreatedAt.Date >= today.AddDays(-7)),
                _ => query
            };

            return query;
        }
    }

    private void OpenModal(MedicalRecord? record = null)
    {
        FormError = null;
        if (record == null)
        {
            FormData = new RecordFormModel();
        }
        else
        {
            FormData = new RecordFormModel
            {
                RecordID = record.RecordID,
                PatientID = record.PatientID,
                Diagnosis = record.Diagnosis
            };
        }

        ShowModalFlag = true;
    }

    private void CloseModal()
    {
        ShowModalFlag = false;
        FormError = null;
    }

    private async Task SaveRecordAsync()
    {
        if (FormData.PatientID <= 0)
        {
            FormError = "Please select a patient.";
            return;
        }

        if (string.IsNullOrWhiteSpace(FormData.Diagnosis))
        {
            FormError = "Diagnosis is required.";
            return;
        }

        if (FormData.RecordID == 0)
        {
            var record = new MedicalRecord
            {
                PatientID = FormData.PatientID,
                DoctorID = Auth.CurrentUserID,
                Diagnosis = FormData.Diagnosis.Trim(),
                CreatedAt = DateTime.UtcNow
            };
            Db.MedicalRecords.Add(record);
        }
        else
        {
            var record = await Db.MedicalRecords.FirstOrDefaultAsync(r => r.RecordID == FormData.RecordID && r.DoctorID == Auth.CurrentUserID);
            if (record == null)
            {
                FormError = "Record not found.";
                return;
            }

            record.PatientID = FormData.PatientID;
            record.Diagnosis = FormData.Diagnosis.Trim();
        }

        await Db.SaveChangesAsync();
        CloseModal();
        await LoadRecordsAsync();
    }

    private void OpenDetails(MedicalRecord record)
    {
        SelectedRecord = record;
        ShowDetailsModal = true;
    }

    private void CloseDetails()
    {
        SelectedRecord = null;
        ShowDetailsModal = false;
    }

    private void ConfirmDelete(MedicalRecord record)
    {
        RecordToDelete = record;
        ShowDeleteConfirm = true;
    }

    private async Task DeleteRecordAsync()
    {
        if (RecordToDelete == null) return;
        var record = await Db.MedicalRecords.FirstOrDefaultAsync(r => r.RecordID == RecordToDelete.RecordID && r.DoctorID == Auth.CurrentUserID);
        if (record != null)
        {
            Db.MedicalRecords.Remove(record);
            await Db.SaveChangesAsync();
        }
        ShowDeleteConfirm = false;
        RecordToDelete = null;
        await LoadRecordsAsync();
    }

    private sealed class RecordFormModel
    {
        public int RecordID { get; set; }
        public int PatientID { get; set; }
        public string Diagnosis { get; set; } = string.Empty;
    }
}

<div class="page-header">
    <h1>Medical Records</h1>
    <button class="btn btn-primary" @onclick="() => OpenModal()">Create Record</button>
</div>

@if (ShowModalFlag)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(FormData.RecordID == 0 ? "Create Medical Record" : "Edit Medical Record")</h2>
                <button class="modal-close" @onclick="CloseModal">X</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Patient</label>
                    <select @bind="FormData.PatientID">
                        <option value="0">Select patient</option>
                        @foreach (var patient in Patients)
                        {
                            <option value="@patient.PatientID">@patient.FullName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Diagnosis</label>
                    <textarea rows="4" placeholder="Enter diagnosis" @bind="FormData.Diagnosis"></textarea>
                </div>
                @if (!string.IsNullOrWhiteSpace(FormError))
                {
                    <p class="form-error">@FormError</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveRecordAsync">Save Record</button>
            </div>
        </div>
    </div>
}

<div class="filters">
    <input type="text" class="filter-input" placeholder="Search by patient or diagnosis" @bind="SearchTerm" @bind:event="oninput" />
    <select class="filter-select" @bind="DateFilter">
        <option value="All">All Records</option>
        <option value="Today">Today</option>
        <option value="ThisWeek">This Week</option>
    </select>
    <button class="btn btn-secondary" @onclick="LoadRecordsAsync">Refresh</button>
</div>

<div class="card">
    <table class="records-table">
        <thead>
            <tr>
                <th>Record ID</th>
                <th>Patient</th>
                <th>Date</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!FilteredRecords.Any())
            {
                <tr>
                    <td colspan="5" class="empty-row">No records found.</td>
                </tr>
            }
            else
            {
                @foreach (var record in FilteredRecords)
                {
                    <tr>
                        <td>REC@record.RecordID.ToString("0000")</td>
                        <td>@record.Patient?.FullName</td>
                        <td>@record.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>@record.Diagnosis</td>
                        <td>
                            <button class="btn-small btn-view" @onclick="() => OpenDetails(record)">View</button>
                            <button class="btn-small btn-edit" @onclick="() => OpenModal(record)">Edit</button>
                            <button class="btn-small btn-delete" @onclick="() => ConfirmDelete(record)">Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (ShowDetailsModal && SelectedRecord != null)
{
    <div class="modal-overlay" @onclick="CloseDetails">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Record Details</h2>
                <button class="modal-close" @onclick="CloseDetails">X</button>
            </div>
            <div class="modal-body">
                <p><strong>Patient:</strong> @SelectedRecord.Patient?.FullName</p>
                <p><strong>Date:</strong> @SelectedRecord.CreatedAt.ToString("yyyy-MM-dd")</p>
                <p><strong>Diagnosis:</strong> @SelectedRecord.Diagnosis</p>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm && RecordToDelete != null)
{
    <div class="modal-overlay" @onclick="() => ShowDeleteConfirm = false">
        <div class="modal-content" @onclick:stopPropagation="true" style="max-width:420px">
            <div class="modal-header">
                <h2>Delete Record</h2>
                <button class="modal-close" @onclick="() => ShowDeleteConfirm = false">&times;</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the record for <strong>@RecordToDelete.Patient?.FullName</strong>? This will also delete all linked prescriptions and cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => ShowDeleteConfirm = false">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteRecordAsync">Delete</button>
            </div>
        </div>
    </div>
}

<style>
