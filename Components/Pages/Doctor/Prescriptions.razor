@page "/doctor/prescriptions"
@layout DoctorLayout
@using healthcoreclinic_app_demo.Services
@using healthcoreclinic_app_demo.Data
@using healthcoreclinic_app_demo.Models
@using Microsoft.EntityFrameworkCore
@inject AuthService Auth
@inject ClinicDbContext Db

@code {
    private bool ShowIssuePrescriptionModal;
    private bool ShowDeleteConfirm;
    private List<Prescription> PrescriptionItems = new();
    private List<MedicalRecord> Records = new();
    private PrescriptionFormModel FormData = new();
    private Prescription? PrescriptionToDelete;
    private string SearchTerm = string.Empty;
    private string StatusFilter = "All";
    private string? FormError;

    protected override async Task OnInitializedAsync()
    {
        await LoadPrescriptionsAsync();
    }

    private async Task LoadPrescriptionsAsync()
    {
        Records = await Db.MedicalRecords
            .AsNoTracking()
            .Include(r => r.Patient)
            .Where(r => r.DoctorID == Auth.CurrentUserID)
            .OrderByDescending(r => r.CreatedAt)
            .ToListAsync();

        PrescriptionItems = await Db.Prescriptions
            .AsNoTracking()
            .Include(p => p.Record)
            .ThenInclude(r => r!.Patient)
            .Where(p => p.Record != null && p.Record.DoctorID == Auth.CurrentUserID)
            .OrderByDescending(p => p.Record!.CreatedAt)
            .ToListAsync();
    }

    private IEnumerable<Prescription> FilteredPrescriptions => PrescriptionItems
        .Where(p => string.IsNullOrWhiteSpace(SearchTerm) || (p.Record?.Patient?.FullName ?? string.Empty).Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) || p.Medication.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(p => StatusFilter == "All" || GetStatus(p) == StatusFilter);

    private string GetStatus(Prescription prescription)
    {
        var recordDate = prescription.Record?.CreatedAt ?? DateTime.UtcNow;
        return recordDate >= DateTime.Today.AddDays(-30) ? "Active" : "Completed";
    }

    private void OpenIssuePrescriptionModal()
    {
        FormError = null;
        FormData = new PrescriptionFormModel();
        ShowIssuePrescriptionModal = true;
    }

    private void CloseIssuePrescriptionModal() => ShowIssuePrescriptionModal = false;

    private void ConfirmDelete(Prescription prescription)
    {
        PrescriptionToDelete = prescription;
        ShowDeleteConfirm = true;
    }

    private async Task DeletePrescriptionAsync()
    {
        if (PrescriptionToDelete == null) return;
        var item = await Db.Prescriptions.FirstOrDefaultAsync(p => p.PrescriptionID == PrescriptionToDelete.PrescriptionID);
        if (item != null)
        {
            Db.Prescriptions.Remove(item);
            await Db.SaveChangesAsync();
        }
        ShowDeleteConfirm = false;
        PrescriptionToDelete = null;
        await LoadPrescriptionsAsync();
    }

    private async Task SavePrescriptionAsync()
    {
        if (FormData.RecordID <= 0)
        {
            FormError = "Please select a medical record.";
            return;
        }

        if (string.IsNullOrWhiteSpace(FormData.Medication))
        {
            FormError = "Medication is required.";
            return;
        }

        var prescription = new Prescription
        {
            RecordID = FormData.RecordID,
            Medication = FormData.Medication.Trim(),
            Instructions = FormData.Instructions?.Trim() ?? string.Empty
        };

        Db.Prescriptions.Add(prescription);
        await Db.SaveChangesAsync();
        ShowIssuePrescriptionModal = false;
        await LoadPrescriptionsAsync();
    }

    private sealed class PrescriptionFormModel
    {
        public int RecordID { get; set; }
        public string Medication { get; set; } = string.Empty;
        public string? Instructions { get; set; }
    }
}

<div class="page-header">
    <h1>Prescriptions</h1>
    <button class="btn btn-primary" @onclick="OpenIssuePrescriptionModal">+ Issue Prescription</button>
</div>

@if (ShowIssuePrescriptionModal)
{
    <div class="modal-overlay" @onclick="CloseIssuePrescriptionModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Issue Prescription</h2>
                <button class="modal-close" @onclick="CloseIssuePrescriptionModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Medical Record</label>
                    <select @bind="FormData.RecordID">
                        <option value="0">Select record</option>
                        @foreach (var record in Records)
                        {
                            <option value="@record.RecordID">REC@record.RecordID.ToString("0000") - @record.Patient?.FullName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Medication</label>
                    <input type="text" placeholder="Enter medication" @bind="FormData.Medication" />
                </div>
                <div class="form-group">
                    <label>Instructions</label>
                    <textarea rows="3" placeholder="Special instructions" @bind="FormData.Instructions"></textarea>
                </div>
                @if (!string.IsNullOrWhiteSpace(FormError))
                {
                    <p class="form-error">@FormError</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseIssuePrescriptionModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SavePrescriptionAsync">Save Prescription</button>
            </div>
        </div>
    </div>
}

<div class="filters">
    <input type="text" class="filter-input" placeholder="Search by patient or medication" @bind="SearchTerm" @bind:event="oninput" />
    <select class="filter-select" @bind="StatusFilter">
        <option value="All">All Status</option>
        <option value="Active">Active</option>
        <option value="Completed">Completed</option>
    </select>
    <button class="btn btn-secondary" @onclick="LoadPrescriptionsAsync">Refresh</button>
</div>

<div class="card">
    <table class="prescriptions-table">
        <thead>
            <tr>
                <th>Prescription ID</th>
                <th>Patient</th>
                <th>Medication</th>
                <th>Date Issued</th>
                <th>Status</th>
                            <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!FilteredPrescriptions.Any())
            {
                <tr>
                    <td colspan="6" class="empty-row">No prescriptions found.</td>
                </tr>
            }
            else
            {
                @foreach (var prescription in FilteredPrescriptions)
                {
                    var status = GetStatus(prescription);
                    <tr>
                        <td>PRESC@prescription.PrescriptionID.ToString("0000")</td>
                        <td>@prescription.Record?.Patient?.FullName</td>
                        <td>@prescription.Medication</td>
                        <td>@(prescription.Record?.CreatedAt.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td><span class="badge @(status == "Active" ? "badge-success" : "badge-secondary")">@status</span></td>
                        <td><button class="btn-small btn-delete" @onclick="() => ConfirmDelete(prescription)">Delete</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (ShowDeleteConfirm && PrescriptionToDelete != null)
{
    <div class="modal-overlay" @onclick="() => ShowDeleteConfirm = false">
        <div class="modal-content" @onclick:stopPropagation="true" style="max-width:420px">
            <div class="modal-header">
                <h2>Delete Prescription</h2>
                <button class="modal-close" @onclick="() => ShowDeleteConfirm = false">&times;</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the prescription for <strong>@PrescriptionToDelete.Medication</strong> (@PrescriptionToDelete.Record?.Patient?.FullName)? This cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => ShowDeleteConfirm = false">Cancel</button>
                <button class="btn btn-danger" @onclick="DeletePrescriptionAsync">Delete</button>
            </div>
        </div>
    </div>
}

