@page "/admin/patients"
@layout AdminLayout
@using healthcoreclinic_app_demo.Services
@using healthcoreclinic_app_demo.Models
@inject AuthService Auth

<div class="patients-container">
    <div class="page-header">
        <div>
            <h1>Patient Management</h1>
            <p>Create and manage patient records in the system</p>
        </div>
        <button class="btn btn-primary" @onclick="OpenCreatePatientModal" disabled="@isLoading" style="display: @(showArchived ? "none" : "flex")">
            <span class="icon ui-icon ui-icon-plus" aria-hidden="true"></span>
            <span>New Patient</span>
        </button>
    </div>

    <!-- Tabs -->
    <div class="tabs-section">
        <button class="tab-btn @(showArchived ? "" : "active")" @onclick="SwitchToActive">
            Active Patients
            @if (patients != null && patients.Count > 0)
            {
                <span class="badge">@patients.Count</span>
            }
        </button>
        <button class="tab-btn @(showArchived ? "active" : "")" @onclick="SwitchToArchived">
            Archived Patients
            @if (archivedPatients != null && archivedPatients.Count > 0)
            {
                <span class="badge">@archivedPatients.Count</span>
            }
        </button>
    </div>

    <!-- Search & Filter Bar -->
    <div class="search-filter-bar">
        <div class="search-box">
            <span class="search-icon"><span class="ui-icon ui-icon-search" aria-hidden="true"></span></span>
            <input placeholder="Search by name..." value="@searchTerm" @oninput="OnSearchChanged" />
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button class="clear-search" @onclick="ClearSearch" aria-label="Clear search">
                    <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                </button>
            }
        </div>
        <select class="filter-select" @onchange="OnFilterChanged">
            <option value="">All Genders</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
        </select>
        <span class="results-count">@FilteredList.Count result@(FilteredList.Count != 1 ? "s" : "")</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(messageText))
    {
        <div class="status-message @(isSuccess ? "success" : "error")">
            <span class="msg-icon">
                <span class="ui-icon @(isSuccess ? "ui-icon-check" : "ui-icon-alert")" aria-hidden="true"></span>
            </span>
            <span>@messageText</span>
            <button class="msg-close" @onclick="() => messageText = null" aria-label="Dismiss message">
                <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
            </button>
        </div>
    }

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading patients...</p>
        </div>
    }
    else if (!showArchived && (patients == null || patients.Count == 0))
    {
        <div class="empty-state">
            <div class="empty-icon"><span class="ui-icon ui-icon-users" aria-hidden="true"></span></div>
            <h3>No Active Patients</h3>
            <p>Start by creating your first patient record</p>
            <button class="btn btn-primary" @onclick="OpenCreatePatientModal">
                Create First Patient
            </button>
        </div>
    }
    else if (showArchived && (archivedPatients == null || archivedPatients.Count == 0))
    {
        <div class="empty-state">
            <div class="empty-icon"><span class="ui-icon ui-icon-box" aria-hidden="true"></span></div>
            <h3>No Archived Patients</h3>
            <p>Archived patient records will appear here</p>
        </div>
    }
    else if (FilteredList.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><span class="ui-icon ui-icon-search" aria-hidden="true"></span></div>
            <h3>No Results Found</h3>
            <p>Try adjusting your search or filter</p>
        </div>
    }
    else
    {
        <div class="patients-grid">
            <div class="table-responsive">
                <table class="patients-table">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Birth Date</th>
                            <th>Gender</th>
                            <th>Contact</th>
                            <th>Address</th>
                            <th>@(showArchived ? "Archived" : "Created")</th>
                            <th class="actions-col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in FilteredList)
                        {
                            @if (!showArchived)
                            {
                                <tr class="patient-row" @onclick="() => OpenPatientDetails(patient)" style="cursor: pointer;">
                                    <td class="font-weight-bold">@patient.FullName</td>
                                    <td>@(patient.BirthDate.HasValue ? patient.BirthDate?.ToString("MMM dd, yyyy") : "Not provided")</td>
                                    <td>@(string.IsNullOrEmpty(patient.Gender) ? "-" : patient.Gender)</td>
                                    <td>@(string.IsNullOrEmpty(patient.ContactNumber) ? "-" : patient.ContactNumber)</td>
                                    <td>@(string.IsNullOrEmpty(patient.Address) ? "-" : patient.Address)</td>
                                    <td>@patient.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="actions-col" @onclick:stopPropagation>
                                        <button class="action-btn edit" @onclick="() => OpenEditPatientModal(patient)" title="Edit" aria-label="Edit"><span class="ui-icon ui-icon-edit" aria-hidden="true"></span></button>
                                        <button class="action-btn delete" @onclick="() => ConfirmArchivePatient(patient)" title="Archive" aria-label="Archive"><span class="ui-icon ui-icon-trash" aria-hidden="true"></span></button>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr class="patient-row archived-row" @onclick="() => OpenPatientDetails(patient)" style="cursor: pointer;">
                                    <td class="font-weight-bold">@patient.FullName</td>
                                    <td>@(patient.BirthDate.HasValue ? patient.BirthDate?.ToString("MMM dd, yyyy") : "Not provided")</td>
                                    <td>@(string.IsNullOrEmpty(patient.Gender) ? "-" : patient.Gender)</td>
                                    <td>@(string.IsNullOrEmpty(patient.ContactNumber) ? "-" : patient.ContactNumber)</td>
                                    <td>@(string.IsNullOrEmpty(patient.Address) ? "-" : patient.Address)</td>
                                    <td>@patient.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="actions-col" @onclick:stopPropagation>
                                        <button class="action-btn restore" @onclick="() => ConfirmRestorePatient(patient)" title="Restore" aria-label="Restore"><span class="ui-icon ui-icon-restore" aria-hidden="true"></span></button>
                                        <button class="action-btn delete" @onclick="() => ConfirmPermanentDeletePatient(patient)" title="Delete Permanently" aria-label="Delete Permanently" style="color: #dc2626;"><span class="ui-icon ui-icon-trash" aria-hidden="true"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <!-- Pagination -->
        </div>
    }

    <!-- Create/Edit Modal -->
    @if (showPatientModal)
    {
        <div class="modal-overlay" @onclick="ClosePatientModal">
            <div class="modal-content" @onclick:stopPropagation>
                <div class="modal-header">
                    <h2>@(editingPatient != null ? "Edit Patient" : "Create New Patient")</h2>
                    <button class="close-btn" @onclick="ClosePatientModal" aria-label="Close">
                        <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                    </button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(modalMessage))
                    {
                        <div class="status-message @(modalSuccess ? "success" : "error")">
                            <span class="msg-icon">
                                <span class="ui-icon @(modalSuccess ? "ui-icon-check" : "ui-icon-alert")" aria-hidden="true"></span>
                            </span>
                            <span>@modalMessage</span>
                        </div>
                    }

                    <div class="form-group">
                        <label>Full Name *</label>
                        <input @bind="formData.FullName" 
                               @bind:event="oninput"
                               placeholder="Enter patient full name" 
                               disabled="@isSubmitting" />
                        @if (!string.IsNullOrEmpty(errors["name"]))
                        {
                            <span class="error-text">@errors["name"]</span>
                        }
                    </div>

                    <div class="form-row two-col">
                        <div class="form-group">
                            <label>Birth Date</label>
                            <input @bind:value="formData.BirthDateStr" 
                                   @bind:value:event="onchange"
                                   type="date" 
                                   disabled="@isSubmitting" />
                        </div>
                        <div class="form-group">
                            <label>Gender</label>
                            <select @bind="formData.Gender" disabled="@isSubmitting">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Contact Number</label>
                        <input @bind="formData.ContactNumber" 
                               placeholder="e.g., 09123456789" 
                               disabled="@isSubmitting" />
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        <textarea @bind="formData.Address" 
                                  placeholder="Enter patient address" 
                                  disabled="@isSubmitting"
                                  rows="3"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePatientModal" disabled="@isSubmitting">
                        Cancel
                    </button>
                    <button class="btn btn-primary" @onclick="SavePatient" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="loader"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>@(editingPatient != null ? "Update Patient" : "Create Patient")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Patient Details Modal -->
    @if (showPatientDetails && editingPatient != null)
    {
        <div class="modal-overlay" @onclick="ClosePatientDetails">
            <div class="modal-content details-modal" @onclick:stopPropagation>
                <div class="modal-header">
                    <h2>Patient Details</h2>
                    <button class="close-btn" @onclick="ClosePatientDetails">×</button>
                </div>
                <div class="modal-body">
                    <div class="detail-grid">
                        <div class="detail-item">
                            <label>Full Name</label>
                            <p>@editingPatient.FullName</p>
                        </div>
                        <div class="detail-item">
                            <label>Birth Date</label>
                            <p>@(editingPatient.BirthDate.HasValue ? editingPatient.BirthDate?.ToString("MMMM dd, yyyy") : "Not provided")</p>
                        </div>
                        <div class="detail-item">
                            <label>Gender</label>
                            <p>@(string.IsNullOrEmpty(editingPatient.Gender) ? "-" : editingPatient.Gender)</p>
                        </div>
                        <div class="detail-item">
                            <label>Contact Number</label>
                            <p>@(string.IsNullOrEmpty(editingPatient.ContactNumber) ? "-" : editingPatient.ContactNumber)</p>
                        </div>
                        <div class="detail-item full-width">
                            <label>Address</label>
                            <p>@(string.IsNullOrEmpty(editingPatient.Address) ? "-" : editingPatient.Address)</p>
                        </div>
                        <div class="detail-item">
                            <label>Patient ID</label>
                            <p class="text-muted">#@editingPatient.PatientID</p>
                        </div>
                        <div class="detail-item">
                            <label>Registered</label>
                            <p class="text-muted">@editingPatient.CreatedAt.ToString("MMM dd, yyyy - HH:mm")</p>
                        </div>
                        <div class="detail-item">
                            <label>Status</label>
                            <p>@(editingPatient.IsArchived ? "Archived" : "Active")</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePatientDetails">Close</button>
                    @if (!editingPatient.IsArchived)
                    {
                        <button class="btn btn-primary" @onclick="() => { ClosePatientDetails(); OpenEditPatientModal(editingPatient); }">Edit Patient</button>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Confirm Archive Modal -->
    @if (showConfirmArchive)
    {
        <div class="modal-overlay" @onclick="() => showConfirmArchive = false">
            <div class="modal-content confirm-modal" @onclick:stopPropagation>
                <div class="modal-header">
                    <h2>Archive Patient</h2>
                    <button class="close-btn" @onclick="() => showConfirmArchive = false" aria-label="Close">
                        <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to archive <strong>@patientToArchive?.FullName</strong>? This patient record will be hidden from the list.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showConfirmArchive = false" disabled="@isSubmitting">
                        Cancel
                    </button>
                    <button class="btn btn-danger" @onclick="ArchivePatient" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="loader"></span>
                            <span>Archiving...</span>
                        }
                        else
                        {
                            <span>Archive Patient</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Confirm Restore Modal -->
    @if (showConfirmRestore)
    {
        <div class="modal-overlay" @onclick="() => showConfirmRestore = false">
            <div class="modal-content confirm-modal" @onclick:stopPropagation>
                <div class="modal-header">
                    <h2>Restore Patient</h2>
                    <button class="close-btn" @onclick="() => showConfirmRestore = false" aria-label="Close">
                        <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Restore <strong>@patientToRestore?.FullName</strong> back to active patients?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showConfirmRestore = false" disabled="@isSubmitting">Cancel</button>
                    <button class="btn btn-primary" @onclick="RestorePatient" disabled="@isSubmitting">
                        @if (isSubmitting) { <span class="loader"></span><span>Restoring...</span> } else { <span>Restore Patient</span> }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Confirm Permanent Delete Modal -->
    @if (showConfirmDelete)
    {
        <div class="modal-overlay" @onclick="() => showConfirmDelete = false">
            <div class="modal-content confirm-modal" @onclick:stopPropagation>
                <div class="modal-header">
                    <h2>Delete Permanently</h2>
                    <button class="close-btn" @onclick="() => showConfirmDelete = false" aria-label="Close">
                        <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Permanently delete <strong>@patientToDelete?.FullName</strong>? This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showConfirmDelete = false" disabled="@isSubmitting">Cancel</button>
                    <button class="btn btn-danger" @onclick="PermanentlyDeletePatient" disabled="@isSubmitting">
                        @if (isSubmitting) { <span class="loader"></span><span>Deleting...</span> } else { <span>Delete Permanently</span> }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Patient>? patients;
    private List<Patient>? archivedPatients;
    private Patient? editingPatient;
    private Patient? patientToArchive;
    private Patient? patientToRestore;
    private Patient? patientToDelete;
    private bool showPatientModal;
    private bool showConfirmArchive;
    private bool showConfirmRestore;
    private bool showConfirmDelete;
    private bool showPatientDetails;
    private bool showArchived;
    private bool isLoading = true;
    private bool isSubmitting;
    private string? messageText;
    private bool isSuccess;
    private string? modalMessage;
    private bool modalSuccess;
    private Dictionary<string, string> errors = new() { ["name"] = string.Empty };

    // Search, filter
    private string searchTerm = string.Empty;
    private string genderFilter = string.Empty;

    private List<Patient> FilteredList
    {
        get
        {
            var source = showArchived ? archivedPatients : patients;
            if (source == null) return new();
            return source
                .Where(p => (string.IsNullOrEmpty(searchTerm) || p.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                         && (string.IsNullOrEmpty(genderFilter) || p.Gender == genderFilter))
                .ToList();
        }
    }

    private class FormData
    {
        public string FullName { get; set; } = string.Empty;
        public string? BirthDateStr { get; set; }
        public string? Gender { get; set; }
        public string? ContactNumber { get; set; }
        public string? Address { get; set; }

        public DateTime? GetBirthDate()
        {
            if (string.IsNullOrEmpty(BirthDateStr))
                return null;
            if (DateTime.TryParse(BirthDateStr, out var date))
                return date;
            return null;
        }
    }

    private FormData formData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        isLoading = true;
        patients = await Auth.GetAllPatientsAsync();
        isLoading = false;
    }

    private async Task SwitchToActive() { showArchived = false; await LoadPatients(); }
    private async Task SwitchToArchived() { showArchived = true; await LoadArchivedPatients(); }
    private void OnSearchChanged(ChangeEventArgs e) { searchTerm = e.Value?.ToString() ?? string.Empty; }
    private void OnFilterChanged(ChangeEventArgs e) { genderFilter = e.Value?.ToString() ?? string.Empty; }
    private void ClearSearch() { searchTerm = string.Empty; }

    private void OpenCreatePatientModal()
    {
        editingPatient = null;
        formData = new FormData();
        errors["name"] = string.Empty;
        modalMessage = null;
        showPatientModal = true;
    }

    private void OpenEditPatientModal(Patient patient)
    {
        editingPatient = patient;
        formData = new FormData
        {
            FullName = patient.FullName,
            BirthDateStr = patient.BirthDate?.ToString("yyyy-MM-dd"),
            Gender = patient.Gender,
            ContactNumber = patient.ContactNumber,
            Address = patient.Address
        };
        errors["name"] = string.Empty;
        modalMessage = null;
        showPatientModal = true;
    }

    private void ClosePatientModal()
    {
        showPatientModal = false;
        editingPatient = null;
        formData = new FormData();
        errors["name"] = string.Empty;
    }

    private bool ValidateForm()
    {
        errors["name"] = string.Empty;

        if (string.IsNullOrWhiteSpace(formData.FullName))
            errors["name"] = "Patient name is required.";
        else if (formData.FullName.Length < 3)
            errors["name"] = "Patient name must be at least 3 characters.";

        return string.IsNullOrEmpty(errors["name"]);
    }

    private async Task SavePatient()
    {
        if (!ValidateForm())
        {
            modalSuccess = false;
            modalMessage = "Please fix the errors above.";
            return;
        }

        isSubmitting = true;
        modalMessage = null;

        try
        {
            await Task.Delay(400);

            if (editingPatient != null)
            {
                var result = await Auth.UpdatePatientAsync(
                    editingPatient.PatientID,
                    formData.FullName ?? string.Empty,
                    formData.GetBirthDate(),
                    formData.Gender,
                    formData.ContactNumber,
                    formData.Address);

                modalSuccess = result.Success;
                modalMessage = result.Message;

                if (result.Success)
                {
                    await Task.Delay(800);
                    ClosePatientModal();
                    messageText = result.Message;
                    isSuccess = true;
                    await LoadPatients();
                }
            }
            else
            {
                var result = await Auth.CreatePatientAsync(
                    formData.FullName ?? string.Empty,
                    formData.GetBirthDate(),
                    formData.Gender,
                    formData.ContactNumber,
                    formData.Address);

                modalSuccess = result.Success;
                modalMessage = result.Message;

                if (result.Success)
                {
                    await Task.Delay(800);
                    ClosePatientModal();
                    messageText = result.Message;
                    isSuccess = true;
                    await LoadPatients();
                }
            }
        }
        catch (Exception ex)
        {
            modalSuccess = false;
            modalMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ConfirmArchivePatient(Patient patient)
    {
        patientToArchive = patient;
        showConfirmArchive = true;
    }

    private async Task ArchivePatient()
    {
        if (patientToArchive == null)
            return;

        isSubmitting = true;

        try
        {
            await Task.Delay(400);
            var result = await Auth.ArchivePatientAsync(patientToArchive.PatientID);

            messageText = result.Message;
            isSuccess = result.Success;

            if (result.Success)
            {
                await Task.Delay(600);
                showConfirmArchive = false;
                patientToArchive = null;
                await LoadPatients();
            }
        }
        catch (Exception ex)
        {
            messageText = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LoadArchivedPatients()
    {
        isLoading = true;
        archivedPatients = await Auth.GetArchivedPatientsAsync();
        isLoading = false;
    }

    private void OpenPatientDetails(Patient patient)
    {
        editingPatient = patient;
        showPatientDetails = true;
    }

    private void ClosePatientDetails()
    {
        showPatientDetails = false;
        editingPatient = null;
    }

    private void ConfirmRestorePatient(Patient patient)
    {
        patientToRestore = patient;
        showConfirmRestore = true;
    }

    private async Task RestorePatient()
    {
        if (patientToRestore == null)
            return;

        isSubmitting = true;

        try
        {
            await Task.Delay(400);
            var result = await Auth.RestorePatientAsync(patientToRestore.PatientID);

            messageText = result.Message;
            isSuccess = result.Success;

            if (result.Success)
            {
                await Task.Delay(600);
                showConfirmRestore = false;
                patientToRestore = null;
                await LoadArchivedPatients();
                await LoadPatients();
            }
        }
        catch (Exception ex)
        {
            messageText = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ConfirmPermanentDeletePatient(Patient patient)
    {
        patientToDelete = patient;
        showConfirmDelete = true;
    }

    private async Task PermanentlyDeletePatient()
    {
        if (patientToDelete == null)
            return;

        isSubmitting = true;

        try
        {
            await Task.Delay(400);
            var result = await Auth.DeletePatientAsync(patientToDelete.PatientID);

            messageText = result.Message;
            isSuccess = result.Success;

            if (result.Success)
            {
                await Task.Delay(600);
                showConfirmDelete = false;
                patientToDelete = null;
                await LoadArchivedPatients();
            }
        }
        catch (Exception ex)
        {
            messageText = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

<style>
.patients-container {
    padding: 24px;
    max-width: 1400px;
    margin: 0 auto;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
    gap: 16px;
}

.page-header h1 {
    margin: 0;
    color: #1f2937;
    font-size: 28px;
    font-weight: 700;
}

.page-header p {
    margin: 4px 0 0 0;
    color: #6b7280;
    font-size: 14px;
}

.btn {
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
}

.btn-primary {
    background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
    color: #fff;
}

.btn-primary:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(79, 70, 229, 0.3);
}

.btn-secondary {
    background: #e5e7eb;
    color: #1f2937;
    border: 1px solid #d1d5db;
}

.btn-secondary:hover:not(:disabled) {
    background: #d1d5db;
}

.btn-danger {
    background: #dc2626;
    color: #fff;
}

.btn-danger:hover:not(:disabled) {
    background: #b91c1c;
