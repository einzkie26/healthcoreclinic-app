@page "/admin/subscription"
@layout AdminLayout
@using healthcoreclinic_app_demo.Services
@using healthcoreclinic_app_demo.Data
@using healthcoreclinic_app_demo.Models
@using SubscriptionModel = healthcoreclinic_app_demo.Models.Subscription
@using Microsoft.EntityFrameworkCore
@inject AuthService Auth
@inject ClinicDbContext Db

@code {
    private SubscriptionModel? CurrentSubscription;
    private List<SubscriptionModel> SubscriptionHistory = new();
    private List<SubscriptionPlan> Plans = new();
    private SubscriptionPlan? SelectedPlan;
    private DateTime RequestedStartDate = DateTime.Today;
    private bool ShowChangeModal;
    private string? StatusMessage;
    private bool IsSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        Plans = await Db.SubscriptionPlans
            .AsNoTracking()
            .OrderBy(p => p.Price)
            .ToListAsync();

        SubscriptionHistory = await Db.Subscriptions
            .AsNoTracking()
            .Include(s => s.Plan)
            .Where(s => s.AdminID == Auth.CurrentUserID)
            .OrderByDescending(s => s.StartDate)
            .ToListAsync();

        CurrentSubscription = SubscriptionHistory.FirstOrDefault(s => s.Status == "Active")
            ?? SubscriptionHistory.FirstOrDefault();
    }

    private void OpenChangePlan(SubscriptionPlan plan)
    {
        SelectedPlan = plan;
        RequestedStartDate = DateTime.Today;
        ShowChangeModal = true;
    }

    private void CloseChangeModal() => ShowChangeModal = false;

    private async Task ConfirmChangePlan()
    {
        if (SelectedPlan == null)
            return;

        var startDate = RequestedStartDate.Date;
        var currentActive = await Db.Subscriptions
            .FirstOrDefaultAsync(s => s.AdminID == Auth.CurrentUserID && s.Status == "Active");

        if (currentActive != null)
        {
            currentActive.Status = "Replaced";
            currentActive.EndDate = startDate.AddDays(-1);
        }

        var newSubscription = new SubscriptionModel
        {
            AdminID = Auth.CurrentUserID,
            PlanID = SelectedPlan.PlanID,
            StartDate = startDate,
            EndDate = startDate.AddMonths(1),
            Status = "Active"
        };

        Db.Subscriptions.Add(newSubscription);
        await Db.SaveChangesAsync();

        StatusMessage = $"Subscription updated to {SelectedPlan.PlanName}.";
        IsSuccess = true;
        ShowChangeModal = false;
        await LoadDataAsync();
    }
}

<div class="page-header-modern">
    <div>
        <h1 class="page-title">Clinic Subscription</h1>
        <p class="page-subtitle">Manage your plan and billing cycle</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="status-message @(IsSuccess ? "success" : "error")">
        <span>@StatusMessage</span>
        <button class="msg-close" @onclick="() => StatusMessage = null">x</button>
    </div>
}

<div class="subscription-grid">
    <div class="subscription-card current">
        <h3>Current Plan</h3>
        @if (CurrentSubscription?.Plan != null)
        {
            <p class="plan-name">@CurrentSubscription.Plan.PlanName</p>
            <p class="plan-price">PHP @CurrentSubscription.Plan.Price / month</p>
            <p class="plan-status">Status: <span class="status-active">@CurrentSubscription.Status</span></p>
            <p class="plan-dates">@CurrentSubscription.StartDate.ToString("MMM dd, yyyy") - @(CurrentSubscription.EndDate?.ToString("MMM dd, yyyy") ?? "Open-ended")</p>
        }
        else
        {
            <p class="help-text">No active subscription found.</p>
        }
    </div>

    <div class="subscription-card">
        <h3>Available Plans</h3>
        @if (Plans.Count == 0)
        {
            <p class="help-text">No plans configured yet.</p>
        }
        else
        {
            <div class="plan-list">
                @foreach (var plan in Plans)
                {
                    <div class="plan-row">
                        <div>
                            <p class="plan-name">@plan.PlanName</p>
                            <p class="plan-meta">PHP @plan.Price / month</p>
                            <p class="plan-meta">
                                Doctors: @(plan.MaxDoctors?.ToString() ?? "Unlimited") | Receptionists: @(plan.MaxReceptionists?.ToString() ?? "Unlimited")
                            </p>
                        </div>
                        <button class="btn btn-primary" @onclick="() => OpenChangePlan(plan)">Select</button>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="card">
    <h3>Subscription History</h3>
    @if (SubscriptionHistory.Count == 0)
    {
        <p class="help-text">No subscription history available.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Plan</th>
                        <th>Status</th>
                        <th>Start</th>
                        <th>End</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in SubscriptionHistory)
                    {
                        <tr>
                            <td>@sub.Plan?.PlanName</td>
                            <td><span class="badge">@sub.Status</span></td>
                            <td>@sub.StartDate.ToString("MMM dd, yyyy")</td>
                            <td>@(sub.EndDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (ShowChangeModal && SelectedPlan != null)
{
    <div class="modal-overlay" @onclick="CloseChangeModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Confirm Plan Change</h2>
                <button class="modal-close" @onclick="CloseChangeModal">x</button>
            </div>
            <div class="modal-body">
                <p>You are about to switch to <strong>@SelectedPlan.PlanName</strong>.</p>
                <div class="form-group">
                    <label>Start Date</label>
                    <input type="date" @bind="RequestedStartDate" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseChangeModal">Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmChangePlan">Confirm</button>
            </div>
        </div>
    </div>
}

<style>
