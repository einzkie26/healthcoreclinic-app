@page "/admin"
@layout AdminLayout
@using healthcoreclinic_app_demo.Services
@using healthcoreclinic_app_demo.Data
@using healthcoreclinic_app_demo.Models
@using Microsoft.EntityFrameworkCore
@using SubscriptionModel = healthcoreclinic_app_demo.Models.Subscription
@inject AuthService Auth
@inject ClinicDbContext Db

@code {
    private int TodayAppointments;
    private int ActiveDoctors;
    private int TotalPatients;
    private decimal DailyRevenue;
    private int AvailableResources;
    private int TotalResources;
    private int BedsOccupied;
    private int TotalBeds;
    private List<ActivityItem> RecentActivities = new();
    private List<TrendPoint> VisitTrend = new();
    private List<ChartPoint> VisitTrendChartPoints = new();
    private string VisitTrendPolyline = string.Empty;
    private SubscriptionModel? CurrentSubscription;
    private SubscriptionPlan? CurrentPlan;
    private bool HasAnalyticsAccess = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        var today = DateTime.Today;
        var tomorrow = today.AddDays(1);

        TodayAppointments = await Db.Appointments
            .AsNoTracking()
            .CountAsync(a => a.AppointmentDate >= today && a.AppointmentDate < tomorrow);

        ActiveDoctors = await Db.Users
            .AsNoTracking()
            .Include(u => u.Role)
            .CountAsync(u => u.IsActive && u.Role != null && u.Role.RoleName == "Doctor");

        TotalPatients = await Db.Patients
            .AsNoTracking()
            .CountAsync(p => !p.IsArchived);

        DailyRevenue = await Db.Payments
            .AsNoTracking()
            .Where(p => p.PaymentDate >= today && p.PaymentDate < tomorrow)
            .SumAsync(p => (decimal?)p.AmountPaid) ?? 0m;

        var resources = await Db.Resources.AsNoTracking().ToListAsync();
        TotalResources = resources.Count;
        AvailableResources = resources.Count(r => r.Status == "Available");

        var bedResources = resources
            .Where(r => r.ResourceName.Contains("Bed") || r.ResourceType.Contains("Bed"))
            .ToList();

        TotalBeds = bedResources.Count;
        BedsOccupied = bedResources.Count(r => r.Status != "Available");

        var recentAppointments = await Db.Appointments
            .AsNoTracking()
            .Include(a => a.Patient)
            .OrderByDescending(a => a.AppointmentDate)
            .Take(4)
            .ToListAsync();

        var recentPayments = await Db.Payments
            .AsNoTracking()
            .Include(p => p.Invoice)
            .ThenInclude(i => i!.Patient)
            .OrderByDescending(p => p.PaymentDate)
            .Take(4)
            .ToListAsync();

        RecentActivities = recentAppointments
            .Select(a => new ActivityItem
            {
                Title = $"Appointment: {a.Patient?.FullName ?? "Patient"}",
                Meta = a.AppointmentDate.ToString("MMM dd, yyyy HH:mm"),
                Badge = a.Status,
                BadgeClass = "badge-info",
                Timestamp = a.AppointmentDate
            })
            .Concat(recentPayments.Select(p => new ActivityItem
            {
                Title = $"Payment received: ₱{p.AmountPaid:N2}",
                Meta = p.Invoice?.Patient?.FullName ?? "Patient",
                Badge = p.PaymentDate.ToString("MMM dd"),
                BadgeClass = "badge-success",
                Timestamp = p.PaymentDate
            }))
            .OrderByDescending(a => a.Timestamp)
            .Take(6)
            .ToList();

        CurrentSubscription = await Db.Subscriptions
            .AsNoTracking()
            .Include(s => s.Plan)
            .Where(s => s.AdminID == Auth.CurrentUserID)
            .OrderByDescending(s => s.StartDate)
            .FirstOrDefaultAsync(s => s.Status == "Active")
            ?? await Db.Subscriptions
                .AsNoTracking()
                .Include(s => s.Plan)
                .Where(s => s.AdminID == Auth.CurrentUserID)
                .OrderByDescending(s => s.StartDate)
                .FirstOrDefaultAsync();

        CurrentPlan = CurrentSubscription?.Plan;
        HasAnalyticsAccess = CurrentPlan?.HasAnalytics ?? true;

        if (HasAnalyticsAccess)
            await LoadVisitTrendAsync(today);
    }

    private async Task LoadVisitTrendAsync(DateTime today)
    {
        var startDate = today.AddDays(-6);
        var endDate = today.AddDays(1);

        var appointments = await Db.Appointments
            .AsNoTracking()
            .Where(a => a.AppointmentDate >= startDate && a.AppointmentDate < endDate)
            .ToListAsync();

        VisitTrend = Enumerable.Range(0, 7)
            .Select(i =>
            {
                var date = startDate.AddDays(i);
                var count = appointments.Count(a => a.AppointmentDate.Date == date);
                return new TrendPoint { Date = date, Count = count };
            })
            .ToList();

        BuildVisitTrendChart();
    }

    private string VisitTrendSvgContent = string.Empty;

    private void BuildVisitTrendChart()
    {
        const double width = 320;
        const double height = 160;
        const double padding = 16;
        var max = Math.Max(1, VisitTrend.Max(p => p.Count));
        var step = VisitTrend.Count > 1 ? (width - 2 * padding) / (VisitTrend.Count - 1) : 0;

        VisitTrendChartPoints = VisitTrend
            .Select((point, index) =>
            {
                var x = padding + step * index;
                var y = height - padding - (point.Count / (double)max) * (height - 2 * padding);
                return new ChartPoint
                {
                    X = x,
                    Y = y,
                    Label = point.Date.ToString("ddd"),
                    Value = point.Count
                };
            })
            .ToList();

        VisitTrendPolyline = string.Join(" ", VisitTrendChartPoints.Select(p => $"{p.X:0.#},{p.Y:0.#}"));

        var sb = new System.Text.StringBuilder();

        // Grid lines + Y-axis labels
        foreach (var frac in new[] { 0.25, 0.5, 0.75, 1.0 })
        {
            var gy = (height - padding - frac * (height - 2 * padding)).ToString("0.#");
            var label = ((int)(max * frac)).ToString();
            sb.Append($"<line x1='16' y1='{gy}' x2='304' y2='{gy}' stroke='#e5e7eb' stroke-width='1'/>");
            sb.Append($"<text x='12' y='{gy}' font-size='8' fill='#9ca3af' text-anchor='end' dominant-baseline='middle'>{label}</text>");
        }

        // Area fill
        if (VisitTrendChartPoints.Count > 1)
        {
            var first = VisitTrendChartPoints.First();
            var last = VisitTrendChartPoints.Last();
            var pts = string.Join(" L", VisitTrendChartPoints.Select(p => $"{p.X:0.#},{p.Y:0.#}"));
            sb.Append($"<path d='M{first.X:0.#},144 L{pts} L{last.X:0.#},144 Z' fill='url(#areaGrad)' opacity='0.3'/>");
        }

        // Polyline
        sb.Append($"<polyline points='{VisitTrendPolyline}' fill='none' stroke='#667eea' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>");

        // Dots + value labels
        foreach (var p in VisitTrendChartPoints)
        {
            sb.Append($"<circle cx='{p.X:0.#}' cy='{p.Y:0.#}' r='4' fill='#667eea' stroke='#fff' stroke-width='1.5'/>");
            if (p.Value > 0)
                sb.Append($"<text x='{p.X:0.#}' y='{(p.Y - 8):0.#}' font-size='8' fill='#4f46e5' text-anchor='middle' font-weight='600'>{p.Value}</text>");
        }

        VisitTrendSvgContent = sb.ToString();
    }

    private sealed class ActivityItem
    {
        public string Title { get; set; } = string.Empty;
        public string Meta { get; set; } = string.Empty;
        public string Badge { get; set; } = string.Empty;
        public string BadgeClass { get; set; } = "badge-info";
        public DateTime Timestamp { get; set; }
    }

    private sealed class TrendPoint
    {
        public DateTime Date { get; set; }
        public int Count { get; set; }
    }

    private sealed class ChartPoint
    {
        public double X { get; set; }
        public double Y { get; set; }
        public string Label { get; set; } = string.Empty;
        public int Value { get; set; }
    }
}

<div class="page-container">
    <div class="page-header-modern">
        <div class="header-content">
            <h1 class="page-title">Dashboard</h1>
            <p class="page-subtitle">Clinic operations overview</p>
        </div>
        <div class="header-date">Last updated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon kpi-appointments">
                <span class="ui-icon ui-icon-chart" aria-hidden="true"></span>
            </div>
            <div class="kpi-content">
                <p class="kpi-label">Today's Appointments</p>
                <p class="kpi-value">@TodayAppointments</p>
                <p class="kpi-change neutral">Today</p>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon kpi-doctors">
                <span class="ui-icon ui-icon-users" aria-hidden="true"></span>
            </div>
            <div class="kpi-content">
                <p class="kpi-label">Active Doctors</p>
                <p class="kpi-value">@ActiveDoctors</p>
                <p class="kpi-change neutral">Active</p>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon kpi-patients">
                <span class="ui-icon ui-icon-users" aria-hidden="true"></span>
            </div>
            <div class="kpi-content">
                <p class="kpi-label">Total Patients</p>
                <p class="kpi-value">@TotalPatients</p>
                <p class="kpi-change neutral">Active</p>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon kpi-revenue">
                <span class="ui-icon ui-icon-download" aria-hidden="true"></span>
            </div>
            <div class="kpi-content">
                <p class="kpi-label">Daily Revenue</p>
                <p class="kpi-value">₱@DailyRevenue.ToString("N2")</p>
                <p class="kpi-change neutral">Collected today</p>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="chart-card">
            <div class="chart-header">
                <div>
                    <h3>Patient Visit Trend</h3>
                    <p class="chart-subtitle">Last 7 days</p>
                </div>
                <span class="badge badge-info">@VisitTrend.Sum(p => p.Count) total</span>
            </div>
            @if (HasAnalyticsAccess)
            {
                <div class="chart-wrapper">
                    <svg viewBox="0 0 320 160" class="trend-chart" preserveAspectRatio="xMidYMid meet">
                        <defs>
                            <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#667eea" stop-opacity="0.8" />
                                <stop offset="100%" stop-color="#667eea" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        @((MarkupString)VisitTrendSvgContent)
                    </svg>
                    <div class="trend-labels">
                        @foreach (var point in VisitTrendChartPoints)
                        {
                            <span>@point.Label</span>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="plan-warning">
                    <p>Analytics are not included in your current plan.</p>
                    <p>Upgrade to access visit trends.</p>
                </div>
            }
        </div>

        <div class="stats-card">
            <h3>Clinic Status</h3>
            <div class="stats-list">
                <div class="stat-row">
                    <span class="stat-label">Operating Hours</span>
                    <span class="badge badge-success">Open</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Doctors On Duty</span>
                    <span class="badge badge-success">@ActiveDoctors/@ActiveDoctors</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Resources Status</span>
                    <span class="badge badge-info">@AvailableResources/@TotalResources Available</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Beds Occupied</span>
                    <span class="badge badge-info">@BedsOccupied/@TotalBeds</span>
                </div>
            </div>
        </div>
    </div>

    <div class="subscription-summary">
        <div class="subscription-card">
            <div>
                <h3>Current Subscription</h3>
                @if (CurrentPlan != null && CurrentSubscription != null)
                {
                    <p class="plan-name">@CurrentPlan.PlanName</p>
                    <p class="plan-dates">@CurrentSubscription.StartDate.ToString("MMM dd, yyyy") - @(CurrentSubscription.EndDate?.ToString("MMM dd, yyyy") ?? "Open-ended")</p>
                    <p class="plan-benefits">
                        Doctors: @(CurrentPlan.MaxDoctors?.ToString() ?? "Unlimited") · Receptionists: @(CurrentPlan.MaxReceptionists?.ToString() ?? "Unlimited")
                    </p>
                    <p class="plan-benefits">Resources: @(CurrentPlan.HasResourceAccess ? "Enabled" : "Not Included") · Analytics: @(CurrentPlan.HasAnalytics ? "Enabled" : "Not Included")</p>
                }
                else
                {
                    <p class="plan-dates">No subscription found.</p>
                }
            </div>
        </div>
    </div>
</div>

<style>
* {
    box-sizing: border-box;
}

.page-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
}

.page-header-modern {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
    gap: 20px;
}

.header-content h1 {
    margin: 0 0 8px 0;
}

.page-title {
    font-size: 2.2em;
    font-weight: 700;
    color: #2c3e50;
    margin: 0;
}

.page-subtitle {
    font-size: 0.95em;
    color: #7f8c8d;
    margin: 0;
}

.header-date {
    font-size: 0.9em;
    color: #95a5a6;
    font-weight: 600;
}

.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
    margin-bottom: 30px;
}

.kpi-card {
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    display: flex;
    gap: 16px;
    align-items: flex-start;
    border-left: 4px solid #667eea;
    transition: all 0.3s ease;
}

.kpi-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transform: translateY(-4px);
}

.kpi-icon {
    font-size: 2.5em;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
}

.kpi-appointments {
    background-color: #e3f2fd;
}

.kpi-doctors {
    background-color: #f3e5f5;
}

.kpi-patients {
    background-color: #e8f5e9;
}

.kpi-revenue {
    background-color: #fff3e0;
}

.kpi-content {
    flex: 1;
}

.kpi-label {
    font-size: 0.85em;
    color: #7f8c8d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 8px 0;
    font-weight: 600;
}

.kpi-value {
    font-size: 2em;
    font-weight: 700;
    color: #2c3e50;
    margin: 0 0 8px 0;
}

.kpi-change {
    font-size: 0.85em;
    margin: 0;
}

.kpi-change.positive {
    color: #27ae60;
}

.kpi-change.negative {
    color: #e74c3c;
}

.kpi-change.neutral {
    color: #95a5a6;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
}

.subscription-summary {
    margin-top: 20px;
}

.subscription-card {
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

.subscription-card h3 {
    margin: 0 0 8px 0;
    color: #2c3e50;
}

.plan-name {
    font-size: 1.2em;
    font-weight: 700;
    margin: 4px 0;
    color: #1f2937;
}

.plan-dates {
    margin: 4px 0 8px;
    color: #6b7280;
    font-size: 0.9em;
}

.plan-benefits {
    margin: 4px 0;
    color: #4b5563;
    font-size: 0.9em;
}

.plan-warning {
    background: #fff7ed;
    border-radius: 10px;
    padding: 16px;
    color: #9a3412;
    border: 1px solid #fed7aa;
}

[data-theme="dark"] .subscription-card {
    background: #1f2937;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
}

[data-theme="dark"] .subscription-card h3,
[data-theme="dark"] .plan-name {
    color: #f9fafb;
}

[data-theme="dark"] .plan-dates,
[data-theme="dark"] .plan-benefits {
    color: #cbd5f5;
}

[data-theme="dark"] .plan-warning {
    background: #312e81;
    border-color: #4338ca;
    color: #e0e7ff;
}

.chart-card,
.stats-card {
    background: white;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

.chart-card h3,
.stats-card h3 {
    margin: 0 0 20px 0;
    font-size: 1.1em;
    color: #2c3e50;
    font-weight: 700;
}

.chart-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
}

.chart-subtitle {
    margin: 4px 0 0;
    color: #6b7280;
    font-size: 0.85em;
}

.chart-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.trend-chart {
    width: 100%;
    height: 180px;
}

.trend-line {
    fill: none;
    stroke: #667eea;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.trend-point {
    fill: #667eea;
    stroke: #fff;
    stroke-width: 1.5;
}

.trend-labels {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    font-size: 0.75em;
    color: #9ca3af;
    text-align: center;
}

.stats-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px;
    background-color: #f8f9fa;
    border-radius: 8px;
}

.stat-label {
    font-weight: 600;
    color: #2c3e50;
}

.badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.8em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.badge-success {
    background-color: #d4edda;
    color: #155724;
}

.badge-info {
    background-color: #d1ecf1;
    color: #0c5460;
}

[data-theme="dark"] .page-title {
    color: #f9fafb;
}

[data-theme="dark"] .page-subtitle,
[data-theme="dark"] .header-date,
[data-theme="dark"] .kpi-label,
[data-theme="dark"] .kpi-change,
[data-theme="dark"] .stat-label,
[data-theme="dark"] .chart-subtitle,
[data-theme="dark"] .trend-labels {
    color: #cbd5f5;
}

[data-theme="dark"] .kpi-card,
[data-theme="dark"] .chart-card,
[data-theme="dark"] .stats-card {
    background: #1f2937;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
}

[data-theme="dark"] .kpi-value,
[data-theme="dark"] .chart-card h3,
[data-theme="dark"] .stats-card h3 {
    color: #f9fafb;
}

[data-theme="dark"] .kpi-icon,
[data-theme="dark"] .kpi-appointments,
[data-theme="dark"] .kpi-doctors,
[data-theme="dark"] .kpi-patients,
[data-theme="dark"] .kpi-revenue {
    background-color: #111827 !important;
    color: #e5e7eb;
}

[data-theme="dark"] .stat-row {
    background: #111827;
}

@@media (max-width: 1024px) {
    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

@@media (max-width: 768px) {
    .page-title {
        font-size: 1.8em;
    }

    .kpi-grid {
        grid-template-columns: 1fr;
    }

    .page-header-modern {
        flex-direction: column;
    }
}
</style>
