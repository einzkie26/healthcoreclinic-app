@inherits LayoutComponentBase
@using healthcoreclinic_app_demo.Services
@inject AuthService Auth
@inject NavigationManager Nav

@if (Auth.IsAuthenticated)
{
    <div style="padding:10px; background:#eee; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;">
        <span>Role: @Auth.CurrentRole</span>
        <button @onclick="Logout">Logout</button>
    </div>
}

@Body

@code {
    void Logout()
    {
        Auth.Logout();
        Nav.NavigateTo(AppRoutes.Login);
    }
}
