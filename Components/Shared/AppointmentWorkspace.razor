@using healthcoreclinic_app_demo.Models
@using healthcoreclinic_app_demo.Services
@inject AuthService Auth

<div class="appointment-workspace @ThemeClass">
    <div class="page-header">
        <div>
            <h1>@Title</h1>
            <p>@Subtitle</p>
        </div>
        <div class="header-actions">
            @if (CanManageAppointments)
            {
                <button class="btn btn-primary" @onclick="OpenCreateAppointmentModal">
                    <span class="ui-icon ui-icon-plus" aria-hidden="true"></span>
                    <span>Schedule Appointment</span>
                </button>
            }
            @if (CanManageSchedules)
            {
                <button class="btn btn-secondary" @onclick="OpenScheduleModal">
                    <span class="ui-icon ui-icon-plus" aria-hidden="true"></span>
                    <span>Add Schedule Slot</span>
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(messageText))
    {
        <div class="status-message @(isSuccess ? "success" : "error")">
            <span class="msg-icon">
                <span class="ui-icon @(isSuccess ? "ui-icon-check" : "ui-icon-alert")" aria-hidden="true"></span>
            </span>
            <span>@messageText</span>
            <button class="msg-close" @onclick="() => messageText = null" aria-label="Dismiss message">
                <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
            </button>
        </div>
    }

    <div class="view-tabs">
        <button class="tab-btn @(activeView == "list" ? "active" : "")" @onclick='() => activeView = "list"'>List</button>
        <button class="tab-btn @(activeView == "calendar" ? "active" : "")" @onclick='() => activeView = "calendar"'>Calendar</button>
    </div>

    <div class="filters">
        <div class="search-box">
            <span class="search-icon"><span class="ui-icon ui-icon-search" aria-hidden="true"></span></span>
            <input placeholder="Search patient, doctor, ID, or status..." value="@searchTerm" @oninput="OnSearchChanged" />
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <button class="clear-search" @onclick="ClearSearch" aria-label="Clear search">
                    <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                </button>
            }
        </div>
        <select class="filter-select" value="@statusFilter" @onchange="OnStatusChanged">
            <option value="">All Statuses</option>
            @foreach (var status in AppointmentStatuses)
            {
                <option value="@status">@status</option>
            }
        </select>
        @if (!IsDoctorScoped)
        {
            <select class="filter-select" value="@doctorFilter" @onchange="OnDoctorFilterChanged">
                <option value="0">All Doctors</option>
                @foreach (var doctor in doctors)
                {
                    <option value="@doctor.UserID">@doctor.FullName</option>
                }
            </select>
        }
        <input class="filter-input" type="date" value="@selectedDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
        <button class="btn btn-secondary" @onclick="GoToToday">Today</button>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading appointments...</p>
        </div>
    }
    else if (activeView == "calendar")
    {
        <div class="calendar-card">
            <div class="calendar-header">
                <button class="icon-btn" @onclick="PreviousWeek" aria-label="Previous week">Prev</button>
                <div>
                    <h3>Calendar View</h3>
                    <span class="calendar-range">@WeekStart.ToString("MMM dd") - @WeekStart.AddDays(6).ToString("MMM dd, yyyy")</span>
                </div>
                <button class="icon-btn" @onclick="NextWeek" aria-label="Next week">Next</button>
            </div>

            <div class="calendar-grid">
                @foreach (var day in WeekDays)
                {
                    var dayAppointments = AppointmentsForDay(day);
                    <button type="button" class="calendar-day @(day.Date == selectedDate.Date ? "selected" : "") @(dayAppointments.Count > 0 ? "has-bookings" : "")" @onclick="() => SelectCalendarDay(day)">
                        <span class="day-name">@day.ToString("ddd")</span>
                        <span class="day-date">@day.Day</span>
                        <span class="day-badge">@dayAppointments.Count appointment@(dayAppointments.Count == 1 ? "" : "s")</span>
                    </button>
                }
            </div>
        </div>

        <div class="schedule-grid">
            @foreach (var doctor in VisibleDoctors)
            {
                var doctorAppointments = FilteredAppointments
                    .Where(a => a.DoctorID == doctor.UserID && a.AppointmentDate.Date == selectedDate.Date)
                    .OrderBy(a => a.AppointmentDate)
                    .ToList();
                var doctorSchedules = schedules
                    .Where(s => s.DoctorID == doctor.UserID && s.AvailableDate.Date == selectedDate.Date)
                    .OrderBy(s => s.StartTime)
                    .ToList();

                <div class="schedule-card">
                    <div class="schedule-header">
                        <h3>@doctor.FullName</h3>
                        <p class="date">@selectedDate.ToString("dddd, MMMM dd, yyyy")</p>
                    </div>
                    <div class="schedule-times">
                        @if (doctorSchedules.Count == 0 && doctorAppointments.Count == 0)
                        {
                            <div class="time-slot available">
                                <p class="time">No schedule yet</p>
                                <p class="patient">Add a schedule slot to open availability</p>
                            </div>
                        }
                        @foreach (var schedule in doctorSchedules)
                        {
                            <div class="time-slot available">
                                <p class="time">@FormatTime(schedule.StartTime) - @FormatTime(schedule.EndTime)</p>
                                <p class="patient">Available</p>
                                @if (CanManageSchedules)
                                {
                                    <button class="link-btn danger" @onclick="() => DeleteSchedule(schedule.ScheduleID)">Remove slot</button>
                                }
                            </div>
                        }
                        @foreach (var appointment in doctorAppointments)
                        {
                            <div class="time-slot booked">
                                <p class="time">@appointment.AppointmentDate.ToString("hh:mm tt")</p>
                                <p class="patient">@appointment.Patient?.FullName - @appointment.Status</p>
                                <div class="slot-actions">
                                    @if (CanEditAppointments)
                                    {
                                        <button class="link-btn" @onclick="() => OpenEditAppointmentModal(appointment)">Edit</button>
                                        <button class="link-btn danger" @onclick="() => CancelAppointment(appointment.AppointmentID)">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="link-btn" @onclick="() => OpenViewAppointmentModal(appointment)">View</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card">
            @if (FilteredAppointments.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><span class="ui-icon ui-icon-search" aria-hidden="true"></span></div>
                    <h3>No Appointments Found</h3>
                    <p>Try adjusting your search, doctor, status, or date filters.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="appointments-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date & Time</th>
                                <th>Resource</th>
                                <th>Status</th>
                                @if (IsReceptionistScoped)
                                {
                                    <th>Completed By</th>
                                }
                                <th class="actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in PagedAppointments)
                            {
                                <tr>
                                    <td>APT@appointment.AppointmentID.ToString("D3")</td>
                                    <td>@appointment.Patient?.FullName</td>
                                    <td>@appointment.Doctor?.FullName</td>
                                    <td>@appointment.AppointmentDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                                    <td>@(appointment.Resource?.ResourceName ?? "-")</td>
                                    <td><span class="badge @GetStatusClass(appointment.Status)">@appointment.Status</span></td>
                                    @if (IsReceptionistScoped)
                                    {
                                        <td>@(appointment.Status == "Completed" ? appointment.Doctor?.FullName : "-")</td>
                                    }
                                    <td class="actions-col">
                                        @if (CanEditAppointments)
                                        {
                                            <button class="action-btn" @onclick="() => OpenEditAppointmentModal(appointment)" title="Edit" aria-label="Edit appointment">
                                                <span class="ui-icon ui-icon-edit" aria-hidden="true"></span>
                                            </button>
                                            @if (appointment.Status != "Completed")
                                            {
                                                <button class="action-btn success" @onclick='() => ChangeStatus(appointment.AppointmentID, "Completed")' title="Mark Completed" aria-label="Mark completed">
                                                    <span class="ui-icon ui-icon-check" aria-hidden="true"></span>
                                                </button>
                                            }
                                            @if (appointment.Status != "Cancelled")
                                            {
                                                <button class="action-btn danger" @onclick="() => CancelAppointment(appointment.AppointmentID)" title="Cancel" aria-label="Cancel appointment">
                                                    <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <button class="action-btn" @onclick="() => OpenViewAppointmentModal(appointment)" title="View" aria-label="View appointment">
                                                <span class="ui-icon ui-icon-search" aria-hidden="true"></span>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (TotalPages > 1)
                {
                    <div class="pagination">
                        <button class="page-btn" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)">Prev</button>
                        @for (var p = 1; p <= TotalPages; p++)
                        {
                            var pageNumber = p;
                            <button class="page-btn @(pageNumber == currentPage ? "active" : "")" @onclick="() => GoToPage(pageNumber)">@(pageNumber)</button>
                        }
                        <button class="page-btn" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == TotalPages)">Next</button>
                        <span class="page-info">Page @currentPage of @TotalPages</span>
                    </div>
                }
            }
        </div>
    }
</div>

@if (showAppointmentModal)
{
    <div class="modal-overlay" @onclick="CloseAppointmentModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(editingAppointmentId.HasValue ? "Edit Appointment" : "Schedule Appointment")</h2>
                <button class="close-btn" @onclick="CloseAppointmentModal" aria-label="Close">
                    <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Patient *</label>
                    <select @bind="appointmentForm.PatientID">
                        <option value="0">Select patient</option>
                        @foreach (var patient in patients)
                        {
                            <option value="@patient.PatientID">@patient.FullName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Doctor *</label>
                    <select @bind="appointmentForm.DoctorID" disabled="@IsDoctorScoped">
                        <option value="0">Select doctor</option>
                        @foreach (var doctor in doctors)
                        {
                            <option value="@doctor.UserID">@doctor.FullName</option>
                        }
                    </select>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Date *</label>
                        <input type="date" @bind="appointmentForm.Date" />
                    </div>
                    <div class="form-group">
                        <label>Time *</label>
                        <input type="time" value="@appointmentForm.Time" @onchange="OnAppointmentTimeChanged" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Resource</label>
                    <select @bind="appointmentForm.ResourceID">
                        <option value="0">No resource</option>
                        @foreach (var resource in resources)
                        {
                            <option value="@resource.ResourceID">@resource.ResourceName (@resource.Status)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select @bind="appointmentForm.Status">
                        @foreach (var status in AppointmentStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseAppointmentModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveAppointment" disabled="@isSubmitting">
                    @(isSubmitting ? "Saving..." : "Save Appointment")
                </button>
            </div>
        </div>
    </div>
}

@if (showScheduleModal)
{
    <div class="modal-overlay" @onclick="CloseScheduleModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Add Schedule Slot</h2>
                <button class="close-btn" @onclick="CloseScheduleModal" aria-label="Close">
                    <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Doctor *</label>
                    <select @bind="scheduleForm.DoctorID" disabled="@IsDoctorScoped">
                        <option value="0">Select doctor</option>
                        @foreach (var doctor in doctors)
                        {
                            <option value="@doctor.UserID">@doctor.FullName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Date *</label>
                    <input type="date" @bind="scheduleForm.Date" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Start Time *</label>
                        <input type="time" value="@scheduleForm.StartTime" @onchange="OnScheduleStartChanged" />
                    </div>
                    <div class="form-group">
                        <label>End Time *</label>
                        <input type="time" value="@scheduleForm.EndTime" @onchange="OnScheduleEndChanged" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseScheduleModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveSchedule" disabled="@isSubmitting">
                    @(isSubmitting ? "Saving..." : "Save Slot")
                </button>
            </div>
        </div>
    </div>
}

@if (showViewModal && viewingAppointment != null)
{
    <div class="modal-overlay" @onclick="CloseViewAppointmentModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Appointment Details</h2>
                <button class="close-btn" @onclick="CloseViewAppointmentModal" aria-label="Close">
                    <span class="ui-icon ui-icon-close" aria-hidden="true"></span>
                </button>
            </div>
            <div class="modal-body">
                <div class="detail-grid">
                    <div class="detail-item">
                        <label>Patient</label>
                        <p>@viewingAppointment.Patient?.FullName</p>
                    </div>
                    <div class="detail-item">
                        <label>Doctor</label>
                        <p>@viewingAppointment.Doctor?.FullName</p>
                    </div>
                    <div class="detail-item">
                        <label>Date & Time</label>
                        <p>@viewingAppointment.AppointmentDate.ToString("MMM dd, yyyy hh:mm tt")</p>
                    </div>
                    <div class="detail-item">
                        <label>Resource</label>
                        <p>@(viewingAppointment.Resource?.ResourceName ?? "-")</p>
                    </div>
                    <div class="detail-item">
                        <label>Status</label>
                        <p>@viewingAppointment.Status</p>
                    </div>
                    <div class="detail-item">
                        <label>Completed By</label>
                        <p>@(viewingAppointment.Status == "Completed" ? viewingAppointment.Doctor?.FullName : "-")</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseViewAppointmentModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Scope { get; set; } = "Admin";
    [Parameter] public string InitialView { get; set; } = "list";

    private readonly string[] AppointmentStatuses = ["Scheduled", "In Progress", "Completed", "Cancelled"];
    private List<Appointment> appointments = new();
    private List<DoctorSchedule> schedules = new();
    private List<Patient> patients = new();
    private List<User> doctors = new();
    private List<ClinicResource> resources = new();
    private string activeView = "list";
    private string searchTerm = string.Empty;
    private string statusFilter = string.Empty;
    private int doctorFilter;
    private DateTime selectedDate = DateTime.Today;
    private int currentPage = 1;
    private const int PageSize = 10;
    private bool isLoading = true;
    private bool isSubmitting;
    private string? messageText;
    private bool isSuccess;
    private bool showAppointmentModal;
    private bool showScheduleModal;
    private bool showViewModal;
    private int? editingAppointmentId;
    private Appointment? viewingAppointment;
    private AppointmentForm appointmentForm = new();
    private ScheduleForm scheduleForm = new();

    private bool IsDoctorScoped => Scope.Equals("Doctor", StringComparison.OrdinalIgnoreCase);
    private bool IsReceptionistScoped => Scope.Equals("Receptionist", StringComparison.OrdinalIgnoreCase);
    private bool CanEditAppointments => !IsReceptionistScoped;
    private bool CanManageAppointments => !IsDoctorScoped || Auth.CurrentUserID > 0;
    private bool CanManageSchedules => !Scope.Equals("AdminAppointments", StringComparison.OrdinalIgnoreCase);
    private string ThemeClass => IsDoctorScoped ? "doctor-theme" : Scope.Equals("Receptionist", StringComparison.OrdinalIgnoreCase) ? "receptionist-theme" : "admin-theme";
    private string Title => Scope switch
    {
        "Doctor" => activeView == "calendar" ? "My Calendar" : "Assigned Appointments",
        "DoctorSchedule" => "Schedule",
        _ => "Appointments"
    };
    private string Subtitle => activeView == "calendar" ? "Review daily coverage and booked appointments" : "Create, filter, and update appointment records";
    private DateTime WeekStart => selectedDate.Date.AddDays(-(int)selectedDate.DayOfWeek + (selectedDate.DayOfWeek == DayOfWeek.Sunday ? -6 : 1));
    private IEnumerable<DateTime> WeekDays => Enumerable.Range(0, 7).Select(offset => WeekStart.AddDays(offset));
    private IEnumerable<User> VisibleDoctors => IsDoctorScoped && Auth.CurrentUserID > 0
        ? doctors.Where(d => d.UserID == Auth.CurrentUserID)
        : doctorFilter > 0 ? doctors.Where(d => d.UserID == doctorFilter) : doctors;

    private List<Appointment> FilteredAppointments
    {
        get
        {
            var query = appointments.AsEnumerable();

            if (IsDoctorScoped && Auth.CurrentUserID > 0)
                query = query.Where(a => a.DoctorID == Auth.CurrentUserID);
            else if (doctorFilter > 0)
                query = query.Where(a => a.DoctorID == doctorFilter);

            if (!string.IsNullOrWhiteSpace(statusFilter))
                query = query.Where(a => a.Status == statusFilter);

            if (activeView == "calendar")
                query = query.Where(a => a.AppointmentDate.Date >= WeekStart && a.AppointmentDate.Date <= WeekStart.AddDays(6));
            else if (!IsDoctorScoped)
                query = query.Where(a => a.AppointmentDate.Date == selectedDate.Date);

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(a =>
                    $"APT{a.AppointmentID:D3}".Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (a.Patient?.FullName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (a.Doctor?.FullName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    a.Status.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderBy(a => a.AppointmentDate).ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredAppointments.Count / (double)PageSize));
    private List<Appointment> PagedAppointments => FilteredAppointments.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        activeView = InitialView;
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        patients = await Auth.GetAllPatientsAsync();
        doctors = await Auth.GetUsersByRoleAsync("Doctor");
        resources = await Auth.GetResourcesAsync();
        appointments = await Auth.GetAppointmentsAsync();
        schedules = await Auth.GetDoctorSchedulesAsync(startDate: WeekStart, endDate: WeekStart.AddDays(6));

        if (IsDoctorScoped && Auth.CurrentUserID > 0)
            doctorFilter = Auth.CurrentUserID;

        isLoading = false;
    }

    private List<Appointment> AppointmentsForDay(DateTime day) =>
        FilteredAppointments.Where(a => a.AppointmentDate.Date == day.Date).ToList();

    private void OpenCreateAppointmentModal()
    {
        editingAppointmentId = null;
        appointmentForm = new AppointmentForm
        {
            DoctorID = IsDoctorScoped && Auth.CurrentUserID > 0 ? Auth.CurrentUserID : doctorFilter,
            Date = selectedDate,
            Time = "09:00",
            Status = "Scheduled"
        };
        showAppointmentModal = true;
    }

    private void OpenEditAppointmentModal(Appointment appointment)
    {
        editingAppointmentId = appointment.AppointmentID;
        appointmentForm = new AppointmentForm
        {
            PatientID = appointment.PatientID,
            DoctorID = appointment.DoctorID,
            ResourceID = appointment.ResourceID ?? 0,
            Date = appointment.AppointmentDate.Date,
            Time = appointment.AppointmentDate.ToString("HH:mm"),
            Status = appointment.Status
        };
        showAppointmentModal = true;
    }

    private void OpenViewAppointmentModal(Appointment appointment)
    {
        viewingAppointment = appointment;
        showViewModal = true;
    }

    private void CloseViewAppointmentModal()
    {
        showViewModal = false;
        viewingAppointment = null;
    }

    private void CloseAppointmentModal()
    {
        showAppointmentModal = false;
        editingAppointmentId = null;
        appointmentForm = new AppointmentForm();
    }

    private async Task SaveAppointment()
    {
        isSubmitting = true;
        var appointmentDate = appointmentForm.Date.Date.Add(appointmentForm.GetTime());
        var result = editingAppointmentId.HasValue
            ? await Auth.UpdateAppointmentAsync(editingAppointmentId.Value, appointmentForm.PatientID, appointmentForm.DoctorID, appointmentDate, appointmentForm.ResourceID, appointmentForm.Status)
            : await CreateAppointment(appointmentDate);

        isSuccess = result.Success;
        messageText = result.Message;

        if (result.Success)
        {
            CloseAppointmentModal();
            await LoadData();
        }
        isSubmitting = false;
    }

    private async Task<(bool Success, string Message)> CreateAppointment(DateTime appointmentDate)
    {
        var createdBy = Auth.CurrentUserID > 0 ? Auth.CurrentUserID : appointmentForm.DoctorID;
        var result = await Auth.CreateAppointmentAsync(
            appointmentForm.PatientID,
            appointmentForm.DoctorID,
            appointmentDate,
            appointmentForm.ResourceID,
            appointmentForm.Status,
            createdBy);
        return (result.Success, result.Message);
    }

    private void OpenScheduleModal()
    {
        scheduleForm = new ScheduleForm
        {
            DoctorID = IsDoctorScoped && Auth.CurrentUserID > 0 ? Auth.CurrentUserID : doctorFilter,
            Date = selectedDate,
            StartTime = "09:00",
            EndTime = "17:00"
        };
        showScheduleModal = true;
    }

    private void CloseScheduleModal()
    {
        showScheduleModal = false;
        scheduleForm = new ScheduleForm();
    }

    private async Task SaveSchedule()
    {
        isSubmitting = true;
        var result = await Auth.CreateDoctorScheduleAsync(scheduleForm.DoctorID, scheduleForm.Date, scheduleForm.GetStartTime(), scheduleForm.GetEndTime());
        isSuccess = result.Success;
        messageText = result.Message;
        if (result.Success)
        {
            CloseScheduleModal();
            await LoadData();
        }
        isSubmitting = false;
    }

    private async Task DeleteSchedule(int scheduleId)
    {
        var result = await Auth.DeleteDoctorScheduleAsync(scheduleId);
        isSuccess = result.Success;
        messageText = result.Message;
        if (result.Success)
            await LoadData();
    }

    private async Task ChangeStatus(int appointmentId, string status)
    {
        var result = await Auth.UpdateAppointmentStatusAsync(appointmentId, status);
        isSuccess = result.Success;
        messageText = result.Message;
        if (result.Success)
            await LoadData();
    }

    private Task CancelAppointment(int appointmentId) => ChangeStatus(appointmentId, "Cancelled");

    private void SelectCalendarDay(DateTime day)
    {
        selectedDate = day.Date;
        currentPage = 1;
    }

    private async Task PreviousWeek()
    {
        selectedDate = selectedDate.AddDays(-7);
        await LoadData();
    }

    private async Task NextWeek()
    {
        selectedDate = selectedDate.AddDays(7);
        await LoadData();
    }

    private async Task GoToToday()
    {
        selectedDate = DateTime.Today;
        currentPage = 1;
        await LoadData();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
    }

    private void OnDoctorFilterChanged(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out doctorFilter);
        currentPage = 1;
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            selectedDate = date;
            currentPage = 1;
            await LoadData();
        }
    }

    private void OnAppointmentTimeChanged(ChangeEventArgs e)
    {
        appointmentForm.Time = e.Value?.ToString() ?? "09:00";
    }

    private void OnScheduleStartChanged(ChangeEventArgs e)
    {
        scheduleForm.StartTime = e.Value?.ToString() ?? "09:00";
    }

    private void OnScheduleEndChanged(ChangeEventArgs e)
    {
        scheduleForm.EndTime = e.Value?.ToString() ?? "17:00";
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
            currentPage = page;
    }

    private static string FormatTime(TimeSpan value) => DateTime.Today.Add(value).ToString("hh:mm tt");

    private static string GetStatusClass(string status) => status switch
    {
        "Scheduled" => "badge-success",
        "In Progress" => "badge-info",
        "Completed" => "badge-secondary",
        "Cancelled" => "badge-danger",
        _ => "badge-secondary"
    };

    private class AppointmentForm
    {
        public int PatientID { get; set; }
        public int DoctorID { get; set; }
        public int ResourceID { get; set; }
        public DateTime Date { get; set; } = DateTime.Today;
        public string Time { get; set; } = "09:00";
        public string Status { get; set; } = "Scheduled";

        public TimeSpan GetTime() =>
            TimeSpan.TryParse(Time, out var value) ? value : new TimeSpan(9, 0, 0);
    }

    private class ScheduleForm
    {
        public int DoctorID { get; set; }
        public DateTime Date { get; set; } = DateTime.Today;
        public string StartTime { get; set; } = "09:00";
        public string EndTime { get; set; } = "17:00";

        public TimeSpan GetStartTime() =>
            TimeSpan.TryParse(StartTime, out var value) ? value : new TimeSpan(9, 0, 0);

        public TimeSpan GetEndTime() =>
            TimeSpan.TryParse(EndTime, out var value) ? value : new TimeSpan(17, 0, 0);
    }
}

