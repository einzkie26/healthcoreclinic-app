@page "/receptionist/patients"
@layout ReceptionistLayout
@using healthcoreclinic_app_demo.Services
@inject AuthService Auth

<div class="page-header">
    <h1>Patients</h1>
    <button class="btn btn-primary">+ Register Patient</button>
</div>

<div class="filters">
    <input type="text" class="filter-input" placeholder="Search by name or ID" />
    <select class="filter-select">
        <option>All Statuses</option>
        <option>Active</option>
        <option>Inactive</option>
    </select>
    <button class="btn btn-secondary">Search</button>
</div>

<div class="card">
    <table class="patients-table">
        <thead>
            <tr>
                <th>Patient ID</th>
                <th>Name</th>
