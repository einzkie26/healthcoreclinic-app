}
</style>

@code {
    private bool ShowOverridesModal = false;
    private List<AdminAction> AdminActions = new();

    protected override void OnInitialized()
    {
        // Load sample admin actions for demonstration
        AdminActions = new List<AdminAction>
        {
            new AdminAction
            {
                Id = 1,
                ActionType = "User Suspension",
                AdminName = "John Admin",
                Details = "Suspended user account: dr.mike@clinic.com (Dr. Michael)",
                Timestamp = DateTime.Now.AddHours(-2)
            },
            new AdminAction
            {
                Id = 2,
                ActionType = "Role Change",
                AdminName = "John Admin",
                Details = "Changed role from Doctor to Admin for: sarah.doe@clinic.com",
                Timestamp = DateTime.Now.AddHours(-5)
            },
            new AdminAction
            {
                Id = 3,
                ActionType = "Permission Revocation",
                AdminName = "John Admin",
                Details = "Revoked prescription access for user: nurse.jane@clinic.com",
                Timestamp = DateTime.Now.AddDays(-1)
            }
        };
    }

    private void ShowAdminOverrides()
    {
        ShowOverridesModal = true;
    }

    private void CloseAdminOverrides()
    {
        ShowOverridesModal = false;
    }

    private void ApproveOverride(int actionId)
    {
        var action = AdminActions.FirstOrDefault(a => a.Id == actionId);
        if (action != null)
        {
            AdminActions.Remove(action);
            StateHasChanged();
        }
    }

    private void RejectOverride(int actionId)
    {
        var action = AdminActions.FirstOrDefault(a => a.Id == actionId);
        if (action != null)
        {
            AdminActions.Remove(action);
            StateHasChanged();
        }
    }

    private void RevertAction(int actionId)
    {
        var action = AdminActions.FirstOrDefault(a => a.Id == actionId);
        if (action != null)
        {
            AdminActions.Remove(action);
            StateHasChanged();
        }
    }

    private class AdminAction
    {
        public int Id { get; set; }
        public string ActionType { get; set; }
        public string AdminName { get; set; }
        public string Details { get; set; }
        public DateTime Timestamp { get; set; }
    }
}
