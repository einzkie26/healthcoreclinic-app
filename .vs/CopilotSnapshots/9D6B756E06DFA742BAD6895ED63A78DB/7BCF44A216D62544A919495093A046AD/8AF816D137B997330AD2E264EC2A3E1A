@page "/doctor/medical-records"
@layout DoctorLayout
@using healthcoreclinic_app_demo.Services
@inject AuthService Auth

<div class="page-header">
    <h1>Medical Records</h1>
    <div class="header-buttons">
        <button class="btn btn-primary" @onclick="() => ShowCreateForm('Diagnosis')">Create Diagnosis</button>
        <button class="btn btn-primary" @onclick="() => ShowCreateForm('Treatment')">Create Treatment</button>
        <button class="btn btn-primary" @onclick="() => ShowCreateForm('Test Results')">Create Test Results</button>
    </div>
</div>

<div class="filters">
    <input type="text" class="filter-input" placeholder="Search by patient name" />
    <select class="filter-select">
        <option>All Types</option>
        <option>Diagnosis</option>
        <option>Treatment</option>
        <option>Test Results</option>
    </select>
    <button class="btn btn-secondary">Search</button>
</div>

<div class="card">
    <table class="records-table">
        <thead>
            <tr>
                <th>Record ID</th>
                <th>Patient</th>
                <th>Type</th>
                <th>Date</th>
                <th>Description</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>REC001</td>
                <td>John Doe</td>
                <td>Diagnosis</td>
                <td>2024-01-10</td>
                <td>Hypertension - Stage 1</td>
                <td><span class="badge badge-success">Confirmed</span></td>
                <td>
                    <button class="btn-small btn-view">View</button>
                    <button class="btn-small btn-edit">Edit</button>
                </td>
            </tr>
            <tr>
                <td>REC002</td>
                <td>Jane Smith</td>
                <td>Test Results</td>
                <td>2024-01-12</td>
                <td>Blood Work - Normal</td>
                <td><span class="badge badge-success">Reviewed</span></td>
                <td>
                    <button class="btn-small btn-view">View</button>
                    <button class="btn-small btn-edit">Edit</button>
                </td>
            </tr>
            <tr>
                <td>REC003</td>
                <td>Michael Brown</td>
                <td>Treatment</td>
                <td>2024-01-15</td>
                <td>Physical Therapy - Week 3</td>
                <td><span class="badge badge-info">In Progress</span></td>
                <td>
                    <button class="btn-small btn-view">View</button>
                    <button class="btn-small btn-edit">Edit</button>
                </td>
            </tr>
            <tr>
                <td>REC004</td>
                <td>Sarah Taylor</td>
                <td>Diagnosis</td>
                <td>2024-01-08</td>
                <td>Migraine - Chronic</td>
                <td><span class="badge badge-success">Confirmed</span></td>
                <td>
                    <button class="btn-small btn-view">View</button>
                    <button class="btn-small btn-edit">Edit</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<style>
.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.page-header h1 {
    margin: 0;
    color: #11998e;
}

.btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.95em;
    transition: all 0.3s ease;
}

.btn-primary {
    background-color: #11998e;
    color: white;
}

.btn-primary:hover {
    background-color: #0d7a6f;
}

.btn-secondary {
    background-color: #666;
    color: white;
    padding: 8px 15px;
    font-size: 0.9em;
}

.btn-secondary:hover {
    background-color: #555;
}

.filters {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    background: white;
    padding: 15px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.filter-select,
.filter-input {
    padding: 8px 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.9em;
    flex: 1;
}

.filter-select:focus,
.filter-input:focus {
    outline: none;
    border-color: #11998e;
}

.card {
    background: white;
    border-radius: 8px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.records-table {
    width: 100%;
    border-collapse: collapse;
}

.records-table thead {
    background-color: #f5f5f5;
}

.records-table th {
    padding: 15px;
    text-align: left;
    font-weight: 600;
    color: #333;
    border-bottom: 2px solid #ddd;
}

.records-table td {
    padding: 15px;
    border-bottom: 1px solid #eee;
}

.records-table tbody tr:hover {
    background-color: #f9f9f9;
}

.badge {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.85em;
    font-weight: 600;
}

.badge-success {
    background-color: #e8f5e9;
    color: #388e3c;
}

.badge-info {
    background-color: #e3f2fd;
    color: #1976d2;
}

.btn-small {
    padding: 6px 12px;
    margin-right: 5px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85em;
}

.btn-view {
    background-color: #2196f3;
    color: white;
}

.btn-view:hover {
    background-color: #0b7dda;
}

.btn-edit {
    background-color: #4caf50;
    color: white;
}

.btn-edit:hover {
    background-color: #45a049;
}
</style>
