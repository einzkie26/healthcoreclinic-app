@page "/superadmin/users"
@layout SuperAdminLayout
@using healthcoreclinic_app_demo.Services
@inject AuthService Auth

<div class="page-header">
    <h1>User Management</h1>
    <div class="header-buttons">
        <button class="btn btn-primary">+ Add New User</button>
        <button class="btn btn-override" @onclick="ShowAdminOverrides">⚙️ Override Admin Actions</button>
    </div>
</div>

@if (ShowOverridesModal)
{
    <div class="modal-overlay" @onclick="CloseAdminOverrides">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Admin Action Overrides</h2>
                <button class="modal-close" @onclick="CloseAdminOverrides">✕</button>
            </div>
            <div class="modal-body">
                @if (AdminActions.Count > 0)
                {
                    <div class="overrides-list">
                        @foreach (var action in AdminActions)
                        {
                            <div class="override-item">
                                <div class="override-info">
                                    <h4>@action.ActionType</h4>
                                    <p class="override-user">By: <strong>@action.AdminName</strong></p>
                                    <p class="override-details">@action.Details</p>
                                    <p class="override-time">@action.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</p>
                                </div>
                                <div class="override-actions">
                                    <button class="btn-small btn-approve" @onclick="() => ApproveOverride(action.Id)">Approve</button>
                                    <button class="btn-small btn-reject" @onclick="() => RejectOverride(action.Id)">Reject</button>
                                    <button class="btn-small btn-revert" @onclick="() => RevertAction(action.Id)">Revert</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="no-actions">No pending admin actions to override.</p>
                }
            </div>
        </div>
    </div>
}

<div class="card">
    <table class="users-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td>John Admin</td>
                <td>john@clinic.com</td>
                <td><span class="badge badge-info">Admin</span></td>
                <td><span class="badge badge-success">Active</span></td>
                <td>
                    <button class="btn-small btn-edit">Edit</button>
                    <button class="btn-small btn-delete">Delete</button>
                </td>
            </tr>
            <tr>
                <td>2</td>
                <td>Dr. Sarah</td>
                <td>sarah@clinic.com</td>
                <td><span class="badge badge-warning">Doctor</span></td>
                <td><span class="badge badge-success">Active</span></td>
                <td>
                    <button class="btn-small btn-edit">Edit</button>
                    <button class="btn-small btn-delete">Delete</button>
                </td>
            </tr>
            <tr>
                <td>3</td>
                <td>Mary Reception</td>
                <td>mary@clinic.com</td>
                <td><span class="badge badge-secondary">Reception</span></td>
                <td><span class="badge badge-success">Active</span></td>
                <td>
                    <button class="btn-small btn-edit">Edit</button>
                    <button class="btn-small btn-delete">Delete</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<style>
.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.page-header h1 {
    margin: 0;
    color: #1e3c72;
}

.btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.95em;
    transition: all 0.3s ease;
}

.btn-primary {
    background-color: #2a5298;
    color: white;
}

.btn-primary:hover {
    background-color: #1e3c72;
}

.card {
    background: white;
    border-radius: 8px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.users-table {
    width: 100%;
    border-collapse: collapse;
}

.users-table thead {
    background-color: #f5f5f5;
}

.users-table th {
    padding: 15px;
    text-align: left;
    font-weight: 600;
    color: #333;
    border-bottom: 2px solid #ddd;
}

.users-table td {
    padding: 15px;
    border-bottom: 1px solid #eee;
}

.users-table tbody tr:hover {
    background-color: #f9f9f9;
}

.badge {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.85em;
    font-weight: 600;
}

.badge-info {
    background-color: #e3f2fd;
    color: #1976d2;
}

.badge-warning {
    background-color: #fff3e0;
    color: #f57c00;
}

.badge-secondary {
    background-color: #f3e5f5;
    color: #7b1fa2;
}

.badge-success {
    background-color: #e8f5e9;
    color: #388e3c;
}

.btn-small {
    padding: 6px 12px;
    margin-right: 5px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85em;
}

.btn-edit {
    background-color: #4caf50;
    color: white;
}

.btn-edit:hover {
    background-color: #45a049;
}

.btn-delete {
    background-color: #f44336;
    color: white;
}

.btn-delete:hover {
    background-color: #da190b;
}
</style>
