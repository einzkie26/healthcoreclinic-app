@page "/admin"
@layout AdminLayout
@using healthcoreclinic_app_demo.Services
@inject AuthService Auth

<div class="page-container">
    <div class="page-header-modern">
        <div class="header-content">
            <h1 class="page-title">Dashboard</h1>
            <p class="page-subtitle">Clinic operations overview</p>
        </div>
        <div class="header-date">Last updated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon kpi-appointments">📅</div>
            <div class="kpi-content">
                <p class="kpi-label">Today's Appointments</p>
                <p class="kpi-value">24</p>
                <p class="kpi-change positive">+3 from yesterday</p>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon kpi-doctors">👨‍⚕️</div>
            <div class="kpi-content">
                <p class="kpi-label">Active Doctors</p>
                <p class="kpi-value">12</p>
                <p class="kpi-change positive">All online</p>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon kpi-patients">🧑‍🤝‍🧑</div>
            <div class="kpi-content">
                <p class="kpi-label">Total Patients</p>
                <p class="kpi-value">3,456</p>
                <p class="kpi-change positive">+156 this month</p>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon kpi-revenue">💵</div>
            <div class="kpi-content">
                <p class="kpi-label">Daily Revenue</p>
                <p class="kpi-value">$8,200</p>
                <p class="kpi-change positive">+18% from average</p>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="chart-card">
            <h3>Appointment Trends</h3>
            <div class="chart-placeholder purple">
                <svg viewBox="0 0 300 150">
                    <polyline points="10,120 60,80 110,100 160,40 210,70 260,30" stroke="#667eea" stroke-width="2" fill="none"/>
                    <polyline points="10,120 60,80 110,100 160,40 210,70 260,30" stroke="#764ba2" stroke-width="2" fill="none" opacity="0.3"/>
                </svg>
            </div>
        </div>

        <div class="stats-card">
            <h3>Clinic Status</h3>
            <div class="stats-list">
                <div class="stat-row">
                    <span class="stat-label">Operating Hours</span>
                    <span class="badge badge-success">Open</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Doctors On Duty</span>
                    <span class="badge badge-success">12/12</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Resources Status</span>
                    <span class="badge badge-success">All Available</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Beds Occupied</span>
                    <span class="badge badge-info">8/15</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
* {
    box-sizing: border-box;
}

.page-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
}

.page-header-modern {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
    gap: 20px;
}

.header-content h1 {
    margin: 0 0 8px 0;
}

.page-title {
    font-size: 2.2em;
    font-weight: 700;
    color: #2c3e50;
    margin: 0;
}

.page-subtitle {
    font-size: 0.95em;
    color: #7f8c8d;
    margin: 0;
}

.header-date {
    font-size: 0.9em;
    color: #95a5a6;
    font-weight: 600;
}

.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
    margin-bottom: 30px;
}

.kpi-card {
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    display: flex;
    gap: 16px;
    align-items: flex-start;
    border-left: 4px solid #667eea;
    transition: all 0.3s ease;
}

.kpi-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transform: translateY(-4px);
}

.kpi-icon {
    font-size: 2.5em;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
}

.kpi-appointments {
    background-color: #e3f2fd;
}

.kpi-doctors {
    background-color: #f3e5f5;
}

.kpi-patients {
    background-color: #e8f5e9;
}

.kpi-revenue {
    background-color: #fff3e0;
}

.kpi-content {
    flex: 1;
}

.kpi-label {
    font-size: 0.85em;
    color: #7f8c8d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 8px 0;
    font-weight: 600;
}

.kpi-value {
    font-size: 2em;
    font-weight: 700;
    color: #2c3e50;
    margin: 0 0 8px 0;
}

.kpi-change {
    font-size: 0.85em;
    margin: 0;
}

.kpi-change.positive {
    color: #27ae60;
}

.kpi-change.negative {
    color: #e74c3c;
}

.kpi-change.neutral {
    color: #95a5a6;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
}

.chart-card,
.stats-card {
    background: white;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

.chart-card h3,
.stats-card h3 {
    margin: 0 0 20px 0;
    font-size: 1.1em;
    color: #2c3e50;
    font-weight: 700;
}

.chart-placeholder {
    width: 100%;
    height: 200px;
    border-radius: 8px;
    opacity: 0.7;
    display: flex;
    align-items: center;
    justify-content: center;
}

.chart-placeholder.purple {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.chart-placeholder svg {
    width: 90%;
    height: 90%;
}

.stats-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px;
    background-color: #f8f9fa;
    border-radius: 8px;
}

.stat-label {
    font-weight: 600;
    color: #2c3e50;
}

.badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.8em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.badge-success {
    background-color: #d4edda;
    color: #155724;
}

.badge-info {
    background-color: #d1ecf1;
    color: #0c5460;
}

@@media (max-width: 1024px) {
    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

@@media (max-width: 768px) {
    .page-title {
        font-size: 1.8em;
    }

    .kpi-grid {
        grid-template-columns: 1fr;
    }

    .page-header-modern {
        flex-direction: column;
    }
}
</style>
