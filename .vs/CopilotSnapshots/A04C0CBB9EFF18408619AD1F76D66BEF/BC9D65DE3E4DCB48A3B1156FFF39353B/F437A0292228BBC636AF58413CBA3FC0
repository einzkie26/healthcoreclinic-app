using healthcoreclinic_app_demo.Services;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Configuration;

namespace healthcoreclinic_app_demo
{
	public static class MauiProgram
	{
		public static MauiApp CreateMauiApp()
		{
			var builder = MauiApp.CreateBuilder();
			builder
				.UseMauiApp<App>()
				.ConfigureFonts(fonts =>
				{
					fonts.AddFont("OpenSans-Regular.ttf", "OpenSansRegular");
				});

			builder.Services.AddMauiBlazorWebView();
			builder.Services.AddSingleton<AuthService>();

			// Add configuration
			var config = new ConfigurationBuilder()
				.AddInMemoryCollection(new Dictionary<string, string>
				{
					{ "ConnectionStrings:DefaultConnection", "Data Source=desktop-5i67rfl\\sqlexpress;Initial Catalog=HealthCoreDB;Integrated Security=True;Trust Server Certificate=True" }
				})
				.Build();

			builder.Services.AddSingleton(config);

			// Add DbContext (replace YourDbContext with your actual context class)
			// builder.Services.AddDbContext<YourDbContext>(options =>
			//	options.UseSqlServer(config.GetConnectionString("DefaultConnection")));

#if DEBUG
			builder.Services.AddBlazorWebViewDeveloperTools();
			builder.Logging.AddDebug();
#endif

			return builder.Build();
		}
	}
}
