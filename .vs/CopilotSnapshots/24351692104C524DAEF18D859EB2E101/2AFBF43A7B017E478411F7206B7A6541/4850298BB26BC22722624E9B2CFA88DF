@inherits LayoutComponentBase
@using healthcoreclinic_app_demo.Services
@inject AuthService Auth
@inject NavigationManager Nav

<div class="receptionist-container">
    <aside class="sidebar">
        <div class="sidebar-header">
            <h2>HealthCore</h2>
            <p class="user-role">Receptionist Portal</p>
        </div>

        <nav class="sidebar-menu">
            <a href="/receptionist" class="menu-item @IsActive("/receptionist")">
                Dashboard
            </a>
            <a href="/receptionist/patients" class="menu-item @IsActive("/receptionist/patients")">
                Patients
            </a>
            <a href="/receptionist/appointments" class="menu-item @IsActive("/receptionist/appointments")">
                Appointments
            </a>
            <a href="/receptionist/billing" class="menu-item @IsActive("/receptionist/billing")">
                Billing
            </a>
            <a href="/receptionist/invoices" class="menu-item @IsActive("/receptionist/invoices")">
                Invoices
            </a>
            <a href="/receptionist/schedule" class="menu-item @IsActive("/receptionist/schedule")">
                Schedule
            </a>
        </nav>

        <div class="sidebar-footer">
            <button class="logout-btn" @onclick="HandleLogout">Logout</button>
        </div>
    </aside>

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!Auth.IsAuthenticated || Auth.CurrentRole != "Reception")
        {
            Nav.NavigateTo("/login");
        }
    }

    void HandleLogout()
    {
        Auth.Logout();
        Nav.NavigateTo("/login");
    }

    string IsActive(string url)
    {
        var uri = new Uri(Nav.Uri);
        return uri.LocalPath == url ? "active" : "";
    }
}

<style>
.receptionist-container {
    display: flex;
    height: 100vh;
    background-color: #f5f5f5;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
}

.sidebar {
    width: 250px;
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: white;
    display: flex;
    flex-direction: column;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    overflow-y: auto;
}

.sidebar-header {
    padding: 20px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
}

.sidebar-header h2 {
    margin: 0 0 5px 0;
    font-size: 1.5em;
}

.user-role {
    margin: 5px 0 0 0;
    font-size: 0.9em;
    opacity: 0.8;
}

.sidebar-menu {
    flex: 1;
    padding: 20px 0;
}

.menu-item {
    display: block;
    padding: 15px 20px;
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
    border-left: 4px solid transparent;
    font-size: 0.95em;
}

.menu-item:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-left-color: #fff;
}

.menu-item.active {
    background-color: rgba(255, 255, 255, 0.2);
    border-left-color: #fff;
    font-weight: bold;
}

.sidebar-footer {
    padding: 20px;
    border-top: 2px solid rgba(255, 255, 255, 0.1);
}

.logout-btn {
    width: 100%;
    padding: 10px;
    background-color: #ff6b6b;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.95em;
    transition: background-color 0.3s ease;
}

.logout-btn:hover {
    background-color: #ff5252;
}

.main-content {
    margin-left: 250px;
    flex: 1;
    padding: 30px;
    overflow-y: auto;
}

@@media (max-width: 768px) {
    .sidebar {
        width: 200px;
    }

    .main-content {
        margin-left: 200px;
        padding: 15px;
    }
}
</style>
