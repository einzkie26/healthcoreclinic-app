/* ========================================
   GLOBAL STYLES
   ======================================== */

:root {
    --bg-color: #f5f5f5;
    --text-color: #2c3e50;
    --sidebar-bg: #ffffff;
    --sidebar-text: #2c3e50;
    --sidebar-border: #e2e8f0;
    --sidebar-hover: #f8fafc;
    --sidebar-hover-border: #667eea;
    --sidebar-active: #edf2f7;
}

[data-theme="dark"] {
    --bg-color: #1a202c;
    --text-color: #e2e8f0;
    --sidebar-bg: #2d3748;
    --sidebar-text: #e2e8f0;
    --sidebar-border: #4a5568;
    --sidebar-hover: #4a5568;
    --sidebar-hover-border: #81e6d9;
    --sidebar-active: #4a5568;
}

html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background-color: var(--bg-color);
    color: var(--text-color);
    transition: background-color 0.3s ease, color 0.3s ease;
}

h1:focus {
    outline: none;
}

.valid.modified:not([type=checkbox]) {
    outline: 1px solid #26b050;
}

.invalid {
    outline: 1px solid #e50000;
}

.validation-message {
    color: #e50000;
}

.darker-border-checkbox.form-check-input {
    border-color: #929292;
}

.form-floating > .form-control-plaintext::placeholder, 
.form-floating > .form-control::placeholder {
    color: var(--bs-secondary-color);
    text-align: end;
}

.form-floating > .form-control-plaintext:focus::placeholder, 
.form-floating > .form-control:focus::placeholder {
    text-align: start;
}

/* ========================================
   BLAZOR ERROR UI
   ======================================== */

#blazor-error-ui {
    color-scheme: light only;
    background: lightyellow;
    bottom: 0;
    box-shadow: 0 -1px 2px rgba(0, 0, 0, 0.2);
    box-sizing: border-box;
    display: none;
    left: 0;
    padding: 0.6rem 1.25rem 0.7rem 1.25rem;
    position: fixed;
    width: 100%;
    z-index: 1000;
}

#blazor-error-ui .dismiss {
    cursor: pointer;
    position: absolute;
    right: 0.75rem;
    top: 0.5rem;
}

.blazor-error-boundary {
    background: url(data:image/svg+xml;base64,) no-repeat 1rem/1.8rem, #b32121;
    padding: 1rem 1rem 1rem 3.7rem;
    color: white;
}

.blazor-error-boundary::after {
    content: "An error has occurred."
}

/* ========================================
   SAFE AREA (iOS)
   ======================================== */

.status-bar-safe-area {
    display: none;
}

@supports (-webkit-touch-callout: none) {
    .status-bar-safe-area {
        display: flex;
        position: sticky;
        top: 0;
        height: env(safe-area-inset-top);
        background-color: transparent;
        width: 100%;
        z-index: 1;
    }

    .flex-column, .navbar-brand {
        padding-left: env(safe-area-inset-left);
    }
}

/* ========================================
   LOGIN PAGE STYLES
   ======================================== */

/* LOGIN CONTAINER */
.login-container {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
}

[data-theme="dark"] .login-container {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
}

.login-wrapper {
    width: 100%;
    max-width: 420px;
    animation: slideInDown 0.6s ease-out;
}

/* LOGIN CARD */
.login-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
    overflow: hidden;
    padding: 36px 28px;
    text-align: center;
    border: none;
}

/* HEADER SECTION */
.login-header {
    margin-bottom: 28px;
    padding-bottom: 0;
    border: none;
}

.logo-circle {
    width: 64px;
    height: 64px;
    margin: 0 auto 16px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 32px;
}

.login-title {
    margin: 0 0 8px 0;
    font-size: 32px;
    font-weight: 700;
    color: #1a202c;
    letter-spacing: -0.5px;
}

.login-subtitle {
    margin: 0;
    font-size: 14px;
    color: #718096;
    font-weight: 500;
}

/* FORM SECTION */
.login-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

/* FORM GROUP & LABELS */
.form-group {
    text-align: left;
}

.form-label {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #2d3748;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* INPUT FIELDS */
.input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.form-input {
    width: 100%;
    padding: 11px 12px 11px 38px;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    font-size: 13px;
    font-family: inherit;
    transition: all 0.3s ease;
    background: white;
}

.form-input::placeholder {
    color: #a0aec0;
}

.form-input:focus {
    outline: none;
    background: white;
    border-color: #667eea;
    box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.08);
}

.input-icon {
    position: absolute;
    left: 12px;
    font-size: 16px;
    pointer-events: none;
    color: #cbd5e0;
    transition: color 0.3s ease;
}

.form-input:focus ~ .input-icon {
    color: #667eea;
}

/* ALERT / ERROR MESSAGE */
.alert {
    padding: 12px 14px;
    border-radius: 8px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    animation: slideInDown 0.3s ease-out;
}

.alert-error {
    background: #fff5f5;
    border: 1px solid #fed7d7;
    color: #c53030;
}

.alert-icon {
    font-size: 16px;
    flex-shrink: 0;
    margin-top: 2px;
}

.alert-text {
    flex: 1;
    line-height: 1.4;
}

/* LOGIN BUTTON */
.login-btn {
    width: 100%;
    padding: 11px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: none;
    color: white;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 4px;
}

.login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
}

.login-btn:active {
    transform: translateY(0);
}

/* FOOTER SECTION */
.login-footer {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid #e2e8f0;
}

.demo-info {
    margin: 0;
    font-size: 12px;
    color: #a0aec0;
    font-weight: 500;
}

[data-theme="dark"] .login-card {
    background: #1f2937 !important;
    color: #e2e8f0 !important;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4) !important;
}

[data-theme="dark"] .login-title {
    color: #f8fafc;
}

[data-theme="dark"] .login-subtitle,
[data-theme="dark"] .form-label,
[data-theme="dark"] .demo-info {
    color: #cbd5e1;
}

[data-theme="dark"] .login-footer {
    border-top-color: #334155;
}

[data-theme="dark"] .form-input {
    background: #111827;
    color: #e2e8f0;
    border-color: #334155;
}

[data-theme="dark"] .form-input::placeholder {
    color: #94a3b8;
}

[data-theme="dark"] .form-input:focus {
    border-color: #818cf8;
    box-shadow: 0 0 0 2px rgba(129, 140, 248, 0.2);
}

[data-theme="dark"] .alert-error {
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.35);
    color: #fecaca;
}

/* ========================================
   MODERNIZED GLOBAL COMPONENTS
   ======================================== */

.layout-container {
    display: flex;
    height: 100vh;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
    color: var(--text-color);
}

.sidebar {
    width: 250px;
    background-color: var(--sidebar-bg);
    color: var(--sidebar-text);
    display: flex;
    flex-direction: column;
    box-shadow: 2px 0 15px rgba(0, 0, 0, 0.05);
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    border-right: 1px solid var(--sidebar-border);
    transition: background-color 0.3s ease, color 0.3s ease;
    z-index: 100;
}

[data-theme="dark"] .sidebar {
    box-shadow: 2px 0 15px rgba(0, 0, 0, 0.3);
}

.sidebar-header {
    padding: 24px 20px;
    border-bottom: 1px solid var(--sidebar-border);
}

.sidebar-header h2 {
    margin: 0 0 5px 0;
    font-size: 1.6em;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

[data-theme="dark"] .sidebar-header h2 {
    background: linear-gradient(135deg, #81e6d9 0%, #38b2ac 100%);
    -webkit-background-clip: text;
}

.user-role {
    margin: 5px 0 0 0;
    font-size: 0.85em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #a0aec0;
}

.sidebar-menu {
    flex: 1;
    padding: 24px 0;
}

.menu-item {
    display: flex;
    align-items: center;
    padding: 14px 24px;
    color: var(--sidebar-text);
    text-decoration: none;
    transition: all 0.2s ease;
    border-left: 4px solid transparent;
    font-size: 0.95em;
    font-weight: 500;
}

.menu-item:hover {
    background-color: var(--sidebar-hover);
    border-left-color: var(--sidebar-hover-border);
}

.menu-item.active {
    background-color: var(--sidebar-active);
    border-left-color: var(--sidebar-hover-border);
    font-weight: 700;
    color: var(--sidebar-hover-border);
}

.sidebar-footer {
    padding: 20px 24px;
    border-top: 1px solid var(--sidebar-border);
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.theme-toggle-btn {
    width: 100%;
    padding: 10px;
    background-color: transparent;
    color: var(--sidebar-text);
    border: 1px solid var(--sidebar-border);
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.9em;
    font-weight: 600;
    transition: all 0.2s ease;
}

.theme-toggle-btn:hover {
    background-color: var(--sidebar-hover);
}

.logout-btn {
    width: 100%;
    padding: 10px;
    background-color: #fff1f2;
    color: #e53e3e;
    border: 1px solid #fed7d7;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.9em;
    font-weight: 600;
    transition: all 0.2s ease;
}

[data-theme="dark"] .logout-btn {
    background-color: rgba(229, 62, 62, 0.1);
    border-color: rgba(229, 62, 62, 0.2);
}

.logout-btn:hover {
    background-color: #fed7d7;
    color: #c53030;
}

.main-content {
    margin-left: 250px;
    flex: 1;
    padding: 30px;
    overflow-y: auto;
    background-color: var(--bg-color);
}

@media (max-width: 768px) {
    .sidebar {
        width: 200px;
    }
    .main-content {
        margin-left: 200px;
        padding: 20px;
    }
}

.kpi-card {
    background: linear-gradient(145deg, #ffffff, #f8f9fa) !important;
    border-left: 5px solid #667eea !important;
    border-radius: 16px !important;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05) !important;
    padding: 24px !important;
    transition: transform 0.3s ease, box-shadow 0.3s ease !important;
}

.kpi-card:hover {
    transform: translateY(-6px) scale(1.02) !important;
    box-shadow: 0 12px 30px rgba(102, 126, 234, 0.2) !important;
}

.modern-table {
    border-collapse: separate !important;
    border-spacing: 0 8px !important;
    background: transparent !important;
    box-shadow: none !important;
}

.modern-table thead tr {
    background-color: transparent !important;
}

.modern-table th {
    color: #4a5568 !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    border: none !important;
    padding: 12px 20px !important;
}

.modern-table .table-row td, .modern-table tbody tr td {
    background: white !important;
    border-top: 1px solid transparent !important;
    border-bottom: 1px solid transparent !important;
    padding: 16px 20px !important;
    transition: all 0.3s ease !important;
}

.modern-table .table-row td:first-child, .modern-table tbody tr td:first-child {
    border-top-left-radius: 12px !important;
